{
  "name": "dshfiles-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contract": "node scripts/check-workspace-contract.ts",
    "typecheck": "tsc -p scripts/tsconfig.json && pnpm --dir .. exec turbo run typecheck --filter='./plugins/@dshfiles/*'",
    "test": "pnpm --dir .. exec turbo run test --filter='./plugins/@dshfiles/*' -- --testTimeout=30000",
    "build": "pnpm --dir .. exec turbo run build --filter='./plugins/@dshfiles/*'",
    "check": "pnpm run contract && pnpm run build && pnpm run typecheck && pnpm run test",
    "knip": "pnpm --dir .. run knip --workspace plugins --workspace 'plugins/@dshfiles/*'"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@12.5.1"
}
