{
  "name": "dshfiles-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contract": "node scripts/check-workspace-contract.ts",
    "typecheck": "tsc -p scripts/tsconfig.json && pnpm -r --filter './@dshfiles/*' run typecheck",
    "test": "pnpm -r --filter './@dshfiles/*' run test --testTimeout=30000",
    "build": "pnpm -r --filter './@dshfiles/*' run build",
    "check": "pnpm run contract && pnpm run build && pnpm run typecheck && pnpm run test",
    "knip": "pnpm --dir ../tooling/dshx exec knip --directory ../../plugins --config knip.jsonc --reporter compact"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "7.0.2",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@12.5.1"
}
