{
  "name": "dshfiles-plugins",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "contract": "node scripts/check-workspace-contract.ts",
    "typecheck": "tsc -p scripts/tsconfig.json && pnpm -r --filter './@dshfiles/*' run typecheck",
    "test": "pnpm -r --filter './@dshfiles/*' run test",
    "build": "pnpm -r --filter './@dshfiles/*' run build",
    "check": "pnpm run contract && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
