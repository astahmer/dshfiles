{
  "name": "@dshfiles/optmem-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared, DSH-independent memory primitives used by @dshfiles/memory.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./summary-routes": {
      "types": "./src/summary-routes.ts",
      "default": "./src/summary-routes.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
