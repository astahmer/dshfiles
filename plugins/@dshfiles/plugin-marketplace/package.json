{
  "name": "@dshfiles/plugin-marketplace",
  "version": "0.1.0-preview.0",
  "private": true,
  "description": "A Settings marketplace tab that installs DSH plugins from a Framework Hub catalog.",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "dshx build",
    "check": "dshx check",
    "dev": "dshx dev --open",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "tsc --noEmit",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin",
    "test:e2e": "node ../../../tooling/dshx/scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@dshfiles/plugin-ui": "workspace:*",
    "@dshfiles/shared-runtime": "workspace:*",
    "execa": "catalog:",
    "semver": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@dshfiles/dshx": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "22.20.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/semver": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4",
    "react": ">=18 <20"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "external": [
        "@dshfiles/shared-runtime"
      ],
      "immediately": false
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
