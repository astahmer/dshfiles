{
  "name": "@dshfiles/rich-composer",
  "version": "0.1.0",
  "private": true,
  "description": "Owned fork of DSH's native Conversation plugin with structured session-reference paste.",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "dshx.features.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "dshx build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin",
    "test:e2e": "node ../../../tooling/dshx/scripts/run-e2e.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-api-workspace-controller": "catalog:",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-client-file-upload": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-product-analytics": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "catalog:",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-session": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-file-reference": "0.2.0-rc.2",
    "@deepseek-ai/dsh-goal": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-llm-retry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-plan-mode": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-token-meter": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tool-todo": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@dshfiles/dshx": "workspace:*",
    "@lexical/history": "0.49.0",
    "@lexical/plain-text": "0.49.0",
    "@lexical/text": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "clsx": "catalog:",
    "jsdom": "catalog:",
    "lexical": "0.49.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-file-upload": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-connection"
      ],
      "external": [
        "@deepseek-ai/dsh-agent/types",
        "@deepseek-ai/dsh-api-session-controller/client",
        "@deepseek-ai/dsh-api-session-controller/types",
        "@deepseek-ai/dsh-api-workspace-controller/client",
        "@deepseek-ai/dsh-attachment",
        "@deepseek-ai/dsh-client-file-upload/client",
        "@deepseek-ai/dsh-client-locale/client",
        "@deepseek-ai/dsh-client-product-analytics/client",
        "@deepseek-ai/dsh-client-shortcuts/client",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-layout/client",
        "@deepseek-ai/dsh-client-ui-renderer/client",
        "@deepseek-ai/dsh-client-ui-session/client",
        "@deepseek-ai/dsh-client-ui-settings/client",
        "@deepseek-ai/dsh-commands/brand",
        "@deepseek-ai/dsh-goal/client",
        "@deepseek-ai/dsh-goal/types",
        "@deepseek-ai/dsh-llm-retry/types",
        "@deepseek-ai/dsh-plan-mode/client",
        "@deepseek-ai/dsh-plan-mode/types",
        "@deepseek-ai/dsh-token-meter/client",
        "@deepseek-ai/dsh-tool-todo/client",
        "@deepseek-ai/dsh-workspace/types"
      ],
      "immediately": false
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
