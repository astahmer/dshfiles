{
  "name": "@dshfiles/context-compaction",
  "version": "0.1.0",
  "private": true,
  "description": "Chunked compaction backend that keeps summary requests within the model context window.",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "dshx check && pnpm lint && pnpm fmt:check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src tests dshx.config.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "dshx test",
    "build": "dshx build",
    "dev": "dshx dev --open",
    "prepack": "npm run check && npm run build",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-commands": "catalog:",
    "@deepseek-ai/dsh-compaction": "catalog:",
    "@deepseek-ai/dsh-compaction-basic": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-token-meter": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@dshfiles/dshx": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-compaction": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-token-meter": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
