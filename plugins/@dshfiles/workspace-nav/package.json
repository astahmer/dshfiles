{
  "name": "@dshfiles/workspace-nav",
  "version": "0.1.0",
  "private": true,
  "description": "Owned fork of DSH's native workspace picker: a New thread opens its composer before the Host creates the Session.",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "dshx.features.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "dshx build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-api-workspace-controller": "catalog:",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-product-analytics": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-shortcuts": "catalog:",
    "@deepseek-ai/dsh-client-store": "catalog:",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-session": "catalog:",
    "@deepseek-ai/dsh-client-ui-sidebar": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-jobs": "catalog:",
    "@deepseek-ai/dsh-schedule": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@deepseek-ai/dsh-subagent": "catalog:",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.2",
    "@dshfiles/dshx": "workspace:*",
    "@dshfiles/session-controller": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "clsx": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-remote-access": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-shortcuts": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-store": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "external": [
        "@deepseek-ai/dsh-client-store"
      ],
      "immediately": false
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
