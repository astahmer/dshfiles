{
  "name": "@dshfiles/jev",
  "version": "0.1.0",
  "private": true,
  "description": "The Effect service that asks TypeSafe's Jev one Noul question over HttpClient, with the shared endpoint, request and answer schemas, a `jev classify` span and usage recording through @dshfiles/usage.",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "dshx.features.json"
  ],
  "type": "module",
  "types": "./src/jev.ts",
  "exports": {
    ".": {
      "types": "./src/jev.ts",
      "default": "./dist/jev.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dshfiles/dshx": "workspace:*",
    "@dshfiles/usage": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
