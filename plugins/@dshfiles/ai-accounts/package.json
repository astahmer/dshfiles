{
  "name": "@dshfiles/ai-accounts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "description": "Per-account Codex and OpenCode Go provider instances for DeepSeek Harness, in the spirit of T3 Code.",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./dist/client.js",
    "./locale/en.json": "./locale/en.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@earendil-works/pi-ai": "~0.87.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-storage": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "devDependencies": {
    "@dshfiles/dshx": "link:../../../tooling/dshx/packages/dshx",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.19.0",
    "@types/react": "~18.3.31",
    "react": "^18.3.1",
    "typescript": "^5.9.3",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage": "0.2.0-rc.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@deepseek-ai/cordis": "4.0.4",
        "cordis-plugin-include": "1.0.9",
        "cordis-plugin-loader": "1.0.5"
      }
    }
  }
}
