{
  "schemaVersion": 1,
  "features": [
    {
      "id": "parent-child-question",
      "title": "Ask and answer a child-agent question",
      "summary": "A child asks its direct parent with bounded context and a recommendation policy; only the parent can deliver the answer.",
      "surfaces": [
        "tool",
        "host",
        "storage"
      ],
      "configuration": [],
      "states": [
        "pending",
        "answered",
        "cancelled",
        "expired",
        "interrupted"
      ],
      "failureModes": [
        "A non-parent attempts to answer.",
        "A duplicate operation carries conflicting answer data."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "agent-questions.parent-answer",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "gherkin",
          "id": "agent-questions.restart-reattach",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.parent-child-question-unit-stable-operation-id",
          "file": "plugins/@dshfiles/agent-questions/src/service.test.ts",
          "testName": "returns a stable question id for a duplicate operation"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.parent-child-question-unit-parent-authorization",
          "file": "plugins/@dshfiles/agent-questions/src/service.test.ts",
          "testName": "rejects an answer from any Agent except the recorded direct parent"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.parent-child-question-unit-host-reopen",
          "file": "plugins/@dshfiles/agent-questions/src/storage.test.ts",
          "testName": "keeps a pending question answerable across Host shutdown and durable reopen"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.parent-child-question-unit-wait-reattach",
          "file": "plugins/@dshfiles/agent-questions/src/service.test.ts",
          "testName": "interrupts Host waiters without cancelling their durable question"
        }
      ]
    },
    {
      "id": "question-expiry",
      "title": "Resolve question expiry safely",
      "summary": "Expiry either returns the recommended choice or writes a private deferred Markdown record without treating it as an answer.",
      "surfaces": [
        "tool",
        "host",
        "storage"
      ],
      "configuration": [],
      "states": [
        "recommended-expiry",
        "deferred",
        "cancelled",
        "expired"
      ],
      "failureModes": [
        "Unsafe path, symlink, or overwrite is rejected.",
        "Repeated defer does not create duplicate records."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "agent-questions.expiry-defer",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.question-expiry-unit-recommended-choice",
          "file": "plugins/@dshfiles/agent-questions/src/service.test.ts",
          "testName": "uses the recommended option when a question reaches its persisted deadline"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.question-expiry-unit-deferred-file",
          "file": "plugins/@dshfiles/agent-questions/src/deferred-question.test.ts",
          "testName": "writes private, fenced, idempotent workspace files"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.question-expiry-unit-symlink-protection",
          "file": "plugins/@dshfiles/agent-questions/src/deferred-question.test.ts",
          "testName": "does not follow a workspace questions symlink"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.question-expiry-unit-durable-reattach",
          "file": "plugins/@dshfiles/agent-questions/src/storage.test.ts",
          "testName": "reattaches to a deferred outcome and file path after JSON domain reopen"
        }
      ]
    },
    {
      "id": "revision-pinned-feedback",
      "title": "Submit and resolve anchored Markdown feedback",
      "summary": "Submit line-anchored feedback against the current document revision and deliver accepted, rejected, or deferred resolution receipts to the child.",
      "surfaces": [
        "tool",
        "host",
        "storage"
      ],
      "configuration": [],
      "states": [
        "submitted",
        "accepted",
        "rejected",
        "deferred",
        "stale"
      ],
      "failureModes": [
        "A changed, unreadable, or unsafe Markdown target makes the receipt stale.",
        "Feedback delivery failure is reported without applying stale content."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "agent-questions.feedback-resolution",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "gherkin",
          "id": "agent-questions.stale-anchor",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.revisioned-feedback-unit-current-or-stale-receipt",
          "file": "plugins/@dshfiles/agent-questions/src/revisioned-feedback.test.ts",
          "testName": "records batch resolutions with current or stale revision receipts"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.revisioned-feedback-unit-stale-on-retrieval",
          "file": "plugins/@dshfiles/agent-questions/src/revisioned-feedback.test.ts",
          "testName": "turns a previously current receipt stale if the document changes before retrieval"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.revisioned-feedback-unit-exact-anchor",
          "file": "plugins/@dshfiles/agent-questions/src/markdown-target.test.ts",
          "testName": "captures exact workspace lines against the whole-file revision"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.revisioned-feedback-unit-unsafe-anchor",
          "file": "plugins/@dshfiles/agent-questions/src/markdown-target.test.ts",
          "testName": "rejects traversal, symlinks, and a quote that does not match the source lines"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.revisioned-feedback-unit-durable-receipt",
          "file": "plugins/@dshfiles/agent-questions/src/storage.test.ts",
          "testName": "preserves anchored feedback and late resolution receipts across JSON domain reopen"
        }
      ]
    },
    {
      "id": "bounded-batch-resolution",
      "title": "Resolve feedback in bounded batches",
      "summary": "Accept at most twenty feedback resolutions atomically and reject oversized batches before writing any receipt.",
      "surfaces": [
        "tool",
        "host",
        "storage"
      ],
      "configuration": [],
      "states": [
        "batch-accepted",
        "batch-rejected",
        "partially-stale"
      ],
      "failureModes": [
        "A batch above the maximum is rejected before mutation.",
        "A stale target cannot be automatically re-anchored."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "agent-questions.batch-boundary",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "unit-test",
          "id": "agent-questions.bounded-batch-unit-twenty-item-limit",
          "file": "plugins/@dshfiles/agent-questions/src/revisioned-feedback.test.ts",
          "testName": "accepts batches of 20 and rejects larger batches before resolving any item"
        }
      ]
    }
  ],
  "kind": "bundle"
}
