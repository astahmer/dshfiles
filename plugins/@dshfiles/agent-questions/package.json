{
  "name": "@dshfiles/agent-questions",
  "version": "0.1.0",
  "private": true,
  "description": "Durable parent-scoped question and answer contract for DSH subagents.",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./dist/client.js"
  },
  "scripts": {
    "build": "dshx build",
    "test": "vitest run",
    "verify:scratch": "node scripts/verify-scratch.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin",
    "test:e2e": "node ../../../tooling/dshx/scripts/run-e2e.mjs"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@deepseek-ai/dsh-session-query": "catalog:",
    "@deepseek-ai/dsh-storage": "catalog:",
    "@deepseek-ai/dsh-storage-domain": "catalog:",
    "@deepseek-ai/dsh-storage-json": "catalog:",
    "@deepseek-ai/dsh-subagent": "catalog:",
    "@deepseek-ai/dsh-user-questions": "0.2.0-rc.2",
    "@dshfiles/dshx": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-query": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-subagent": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-user-questions": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "locales": []
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
