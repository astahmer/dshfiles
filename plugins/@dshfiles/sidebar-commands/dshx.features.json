{
  "schemaVersion": 1,
  "features": [
    {
      "id": "dynamic-panel-navigation",
      "title": "Navigate to registered panels",
      "summary": "Offer only currently registered root panels and navigate using their current display labels.",
      "surfaces": ["client", "command", "integration"],
      "reach": ["click button \"Open command palette\"", "fill combobox \"Search the command palette\" \"Go to\"", "expect option \"Go to*\""],
      "configuration": [],
      "states": ["available", "unregistered", "selected"],
      "failureModes": ["An orphan or unregistered panel is omitted.", "A target removed before selection reports a stale-target error."],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "sidebar-commands.panel-navigation",
          "featureFile": "tooling/dshx/e2e/features/sidebar-commands.feature"
        },
        {
          "kind": "gherkin",
          "id": "sidebar-commands.stale-target",
          "featureFile": "tooling/dshx/e2e/features/sidebar-commands.feature"
        },
        {
          "kind": "unit-test",
          "id": "sidebar-commands.dynamic-panel-navigation-unit-registered-panels-only",
          "file": "plugins/@dshfiles/sidebar-commands/src/go-to.test.ts",
          "testName": "lists only panels whose id is a registered main panel, sorted by label"
        },
        {
          "kind": "unit-test",
          "id": "sidebar-commands.dynamic-panel-navigation-unit-panel-label-fallback",
          "file": "plugins/@dshfiles/sidebar-commands/src/go-to.test.ts",
          "testName": "falls back to the panel id when the label is blank"
        },
        {
          "kind": "unit-test",
          "id": "sidebar-commands.dynamic-panel-navigation-unit-stale-target-rejected",
          "file": "plugins/@dshfiles/sidebar-commands/src/go-to.test.ts",
          "testName": "throws synchronously for a target that disappeared, scheduling nothing"
        }
      ]
    },
    {
      "id": "recent-session-navigation",
      "title": "Navigate to a recent session",
      "summary": "Offer at most twenty newest sessions after excluding blank, subagent, and archived sessions, then open the selected session after the palette closes.",
      "surfaces": ["client", "command", "integration"],
      "configuration": [],
      "states": ["available", "filtered", "deferred-open", "stale"],
      "failureModes": ["A stale session row reports an error and leaves current navigation unchanged."],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "sidebar-commands.recent-sessions",
          "featureFile": "tooling/dshx/e2e/features/sidebar-commands.feature"
        },
        {
          "kind": "unit-test",
          "id": "sidebar-commands.recent-session-navigation-unit-recent-session-filter",
          "file": "plugins/@dshfiles/sidebar-commands/src/go-to.test.ts",
          "testName": "hides blank, subagent and archived sessions and orders the rest by recency"
        },
        {
          "kind": "unit-test",
          "id": "sidebar-commands.recent-session-navigation-unit-recent-session-limit",
          "file": "plugins/@dshfiles/sidebar-commands/src/go-to.test.ts",
          "testName": "caps the session list at twenty rows"
        },
        {
          "kind": "unit-test",
          "id": "sidebar-commands.recent-session-navigation-unit-session-list-not-ready",
          "file": "plugins/@dshfiles/sidebar-commands/src/go-to.test.ts",
          "testName": "returns no sessions before the list snapshot lands"
        },
        {
          "kind": "unit-test",
          "id": "sidebar-commands.recent-session-navigation-unit-deferred-navigation",
          "file": "plugins/@dshfiles/sidebar-commands/src/go-to.test.ts",
          "testName": "navigates only after onSelect has returned, so the shell can consume the token first"
        }
      ]
    },
    {
      "id": "thread-sidebar-palette-actions",
      "title": "Expose thread-sidebar actions when supported",
      "summary": "Register palette and search entries only when thread-sidebar acknowledges its cancelable capability probe.",
      "surfaces": ["client", "command", "integration"],
      "configuration": [],
      "states": ["probe-pending", "supported", "unsupported"],
      "failureModes": ["Missing or rejected capability acknowledgement omits the dependent action."],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "sidebar-commands.palette-capability",
          "featureFile": "tooling/dshx/e2e/features/sidebar-commands.feature"
        },
        {
          "kind": "unit-test",
          "id": "sidebar-commands.thread-sidebar-palette-actions-unit-palette-capability-ack",
          "file": "plugins/@dshfiles/sidebar-commands/src/go-to.test.ts",
          "testName": "leads with palette actions only when the thread sidebar acknowledged the palette"
        }
      ]
    }
  ],
  "kind": "bundle"
}
