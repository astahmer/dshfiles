{
  "name": "@dshfiles/dsh-core-runtime",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./agent-loop": {
      "types": "./lib/agent-loop.d.ts",
      "default": "./lib/agent-loop.js"
    },
    "./session": {
      "types": "./lib/session.d.ts",
      "default": "./lib/session.js"
    },
    "./session-persistence-jsonl": {
      "types": "./lib/session-persistence-jsonl.d.ts",
      "default": "./lib/session-persistence-jsonl.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "dshx check && tsc --noEmit -p tsconfig.lib.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.lib.json",
    "build": "tsc -p tsconfig.lib.json && oxfmt lib && dshx build",
    "typecheck:host": "node ../../../scripts/with-local-core-dependencies.mjs pnpm exec tsc --noEmit -p tsconfig.json",
    "build:host": "node ../../../scripts/with-local-core-dependencies.mjs pnpm exec dshx build",
    "lint": "oxlint src dshx.config.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "mime-types": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "link:../../../tooling/dsh-core/agent",
    "@deepseek-ai/dsh-api-session-controller": "link:../../../tooling/dsh-core/api-session-controller",
    "@deepseek-ai/dsh-agent-loop": "link:../../../tooling/dsh-core/agent-loop",
    "@deepseek-ai/dsh-session": "link:../../../tooling/dsh-core/session",
    "@deepseek-ai/dsh-session-persistence": "link:../../../tooling/dsh-core/session-persistence",
    "@deepseek-ai/dsh-session-persistence-jsonl": "link:../../../tooling/dsh-core/session-persistence-jsonl",
    "@dshfiles/dshx": "link:../../../tooling/dshx/packages/dshx",
    "@types/node": "^22.19.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-agent-default-model": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-agent-loop": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-api-gateway": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-brand": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-file-upload": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-cordis-host-runner": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-file-reference": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-fs": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-native-command": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-scope": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence-jsonl": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-projection-cache": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-query": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-title": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-subagent": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tool-cordis": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-typert-registry": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-util-time": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-util-values": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-util-workspace-path": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-deque": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "external": [
        "@deepseek-ai/dsh-api-gateway/client",
        "@deepseek-ai/dsh-api-session-controller/client",
        "@deepseek-ai/dsh-typert-protocol"
      ],
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-file-upload"
      ],
      "platform": "web"
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-cordis-host-runner": {
      "optional": true
    },
    "@deepseek-ai/dsh-tool-cordis": {
      "optional": true
    }
  }
}
