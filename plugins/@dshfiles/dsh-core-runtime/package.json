{
  "name": "@dshfiles/dsh-core-runtime",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./lib/agent.d.ts",
      "default": "./lib/agent.js"
    },
    "./agent-loop": {
      "types": "./lib/agent-loop.d.ts",
      "default": "./lib/agent-loop.js"
    },
    "./session": {
      "types": "./lib/session.d.ts",
      "default": "./lib/session.js"
    },
    "./session-persistence-jsonl": {
      "types": "./lib/session-persistence-jsonl.d.ts",
      "default": "./lib/session-persistence-jsonl.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "dshx check && tsc --noEmit -p tsconfig.lib.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.lib.json",
    "build": "tsc -p tsconfig.lib.json && oxfmt lib && dshx build",
    "lint": "oxlint src dshx.config.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "link:../../../tooling/dsh-core/agent",
    "@deepseek-ai/dsh-agent-loop": "link:../../../tooling/dsh-core/agent-loop",
    "@deepseek-ai/dsh-session": "link:../../../tooling/dsh-core/session",
    "@deepseek-ai/dsh-session-persistence": "link:../../../tooling/dsh-core/session-persistence",
    "@deepseek-ai/dsh-session-persistence-jsonl": "link:../../../tooling/dsh-core/session-persistence-jsonl",
    "@dshfiles/dshx": "link:../../../tooling/dshx/packages/dshx",
    "@types/node": "^22.19.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-agent-loop": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence-jsonl": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
