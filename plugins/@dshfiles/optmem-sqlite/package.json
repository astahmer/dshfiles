{
  "name": "@dshfiles/optmem-sqlite",
  "version": "0.1.0",
  "private": true,
  "description": "node:sqlite store and FTS5 search for the OptMem engine.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bench": "node bench/run.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dshfiles/optmem-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
