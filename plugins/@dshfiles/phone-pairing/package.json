{
  "name": "@dshfiles/phone-pairing",
  "version": "0.1.0",
  "private": true,
  "description": "Public, password-less phone access to DSH: a one-time pairing QR or code, a persistent per-device cookie, and revocation, behind a self-provisioned HTTPS tunnel.",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../../tooling/dshx/packages/dshx/dist/cli/bin.js build",
    "test": "vitest run tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin"
  },
  "dependencies": {
    "@dshfiles/dshx": "workspace:*",
    "@deepseek-ai/schemastery": "3.18.5",
    "@nuintun/qrcode": "5.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.5 <4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
