{
  "name": "@dshfiles/git-worktrees",
  "version": "0.1.0",
  "private": true,
  "description": "Plain git repositories as a VCS provider: opt-in thread isolation in git worktrees, and file snapshots for undo.",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "build": "node ../../../tooling/dshx/packages/dshx/dist/cli/bin.js build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin"
  },
  "dependencies": {
    "@dshfiles/vcs-provider-port": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-workspace": "catalog:",
    "@deepseek-ai/schemastery": "catalog:",
    "@dshfiles/dshx": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "host": {
      "inject": [
        "@deepseek-ai/dsh-tools",
        "@deepseek-ai/dsh-workspace"
      ]
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
