{
  "name": "@dshfiles/vcs-provider-port",
  "version": "0.1.0",
  "private": true,
  "description": "The Host port through which version-control plugins (jj, git worktrees) provide workspace isolation and file snapshots, shared so callers never depend on one provider.",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "dshx.features.json"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./effect": {
      "types": "./src/effect.ts",
      "default": "./dist/effect.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --run build && vitest run && node --test src/runtime-distribution.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@dshfiles/dshx": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
