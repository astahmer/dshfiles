{
  "schemaVersion": 1,
  "features": [
    {
      "id": "pause-stalled-goals",
      "title": "Pause goals after consecutive empty rounds",
      "summary": "Count only empty assistant goal rounds, reset after any meaningful content, and pause the active goal without blocking it.",
      "surfaces": [
        "host",
        "integration"
      ],
      "configuration": [
        {
          "key": "stallThreshold",
          "defaultValue": "3",
          "constraints": "Integer from 2 to 50; invalid values are rejected.",
          "coveredBy": [
            "goal-stall-guard.threshold"
          ]
        }
      ],
      "states": [
        "progress",
        "empty-round-streak",
        "paused",
        "pause-failed"
      ],
      "failureModes": [
        "Tool-only progress is counted as activity.",
        "Pause service failure is logged but does not throw into the session."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "goal-stall-guard.streak-reset",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "gherkin",
          "id": "goal-stall-guard.threshold",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "gherkin",
          "id": "goal-stall-guard.unavailable-goal",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "unit-test",
          "id": "goal-stall-guard.pause-stalled-goals-unit-third-empty-round",
          "file": "plugins/@dshfiles/goal-stall-guard/src/host.test.ts",
          "testName": "pauses the goal on the third consecutive empty round"
        },
        {
          "kind": "unit-test",
          "id": "goal-stall-guard.pause-stalled-goals-unit-two-round-control",
          "file": "plugins/@dshfiles/goal-stall-guard/src/host.test.ts",
          "testName": "the control: two empty rounds are not enough"
        },
        {
          "kind": "unit-test",
          "id": "goal-stall-guard.pause-stalled-goals-unit-spoken-round-control",
          "file": "plugins/@dshfiles/goal-stall-guard/src/host.test.ts",
          "testName": "the control: a round that spoke never pauses the goal"
        },
        {
          "kind": "unit-test",
          "id": "goal-stall-guard.pause-stalled-goals-unit-non-goal-control",
          "file": "plugins/@dshfiles/goal-stall-guard/src/host.test.ts",
          "testName": "the control: empty turns that are not goal rounds never pause the goal"
        },
        {
          "kind": "unit-test",
          "id": "goal-stall-guard.pause-stalled-goals-unit-tool-progress",
          "file": "plugins/@dshfiles/goal-stall-guard/src/host.test.ts",
          "testName": "a tool-only round counts as progress"
        },
        {
          "kind": "unit-test",
          "id": "goal-stall-guard.pause-stalled-goals-unit-custom-threshold",
          "file": "plugins/@dshfiles/goal-stall-guard/src/host.test.ts",
          "testName": "honours a configured threshold of two"
        },
        {
          "kind": "unit-test",
          "id": "goal-stall-guard.pause-stalled-goals-unit-no-goal",
          "file": "plugins/@dshfiles/goal-stall-guard/src/host.test.ts",
          "testName": "ignores an agent with no goal"
        },
        {
          "kind": "unit-test",
          "id": "goal-stall-guard.pause-stalled-goals-unit-inactive-goal",
          "file": "plugins/@dshfiles/goal-stall-guard/src/host.test.ts",
          "testName": "does not pause a goal that is not active"
        },
        {
          "kind": "unit-test",
          "id": "goal-stall-guard.pause-stalled-goals-unit-pause-rejection",
          "file": "plugins/@dshfiles/goal-stall-guard/src/host.test.ts",
          "testName": "a pause rejection is logged, not thrown at the session loop"
        }
      ]
    }
  ],
  "kind": "bundle"
}
