{
  "name": "@dshfiles/goal-stall-guard",
  "version": "0.1.0",
  "private": true,
  "description": "Guard goals against no-progress loops and allow bounded, justified continuation",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "build": "node ../../../tooling/dshx/packages/dshx/dist/cli/bin.js build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin",
    "test:e2e": "node ../../../tooling/dshx/scripts/run-e2e.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-goal": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@dshfiles/dshx": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-goal": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "host": {
      "inject": [
        "@deepseek-ai/dsh-agent",
        "@deepseek-ai/dsh-goal",
        "@deepseek-ai/dsh-session",
        "@deepseek-ai/dsh-session-projection",
        "@deepseek-ai/dsh-tools"
      ]
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
