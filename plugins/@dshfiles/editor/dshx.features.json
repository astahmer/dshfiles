{
  "schemaVersion": 1,
  "features": [
    {
      "id": "workspace-editor",
      "title": "Browse and edit workspace files",
      "summary": "Browse bounded project files, open session-scoped Monaco tabs, search and go to line, preserve dirty drafts, and save through Host file APIs.",
      "surfaces": ["client", "host", "settings", "integration"],
      "reach": ["seed tool-call-thread", "click button \"Collapse sidebar\"", "click button \"New tab\"", "click button \"Editor: Files\"", "expect tree \"Workspace files\""],
      "configuration": [
        {
          "key": "editorPlacement",
          "defaultValue": "workbench",
          "constraints": "One of workbench or right-panel; applies live.",
          "choices": ["workbench", "right-panel"],
          "coveredBy": ["editor.placement"]
        },
        {
          "key": "openFileLinks",
          "defaultValue": "true",
          "constraints": "Boolean; applies live.",
          "coveredBy": ["editor.open-file-links-native-row"]
        }
      ],
      "states": ["loading", "clean", "dirty", "saving", "conflict", "external-change", "saved"],
      "failureModes": [
        "A stale file hash raises a conflict and requires reload or explicit overwrite.",
        "Traversal, symlink, protected metadata, missing parent, and oversized writes are rejected."
      ],
      "externalDependencies": [
        {
          "id": "workspace-filesystem",
          "boundary": "Host project file list/read/write API over a registered local workspace.",
          "deterministicFake": "Use temporary directories with synthetic files and edits; do not read or write a user repository."
        }
      ],
      "verification": [
        {
          "kind": "gherkin",
          "id": "editor.file-browse-open",
          "featureFile": "tooling/dshx/e2e/features/editor.feature"
        },
        {
          "kind": "gherkin",
          "id": "editor.save-conflict",
          "featureFile": "tooling/dshx/e2e/features/editor.feature"
        },
        {
          "kind": "gherkin",
          "id": "editor.write-boundaries",
          "featureFile": "tooling/dshx/e2e/features/editor.feature"
        },
        {
          "kind": "gherkin",
          "id": "editor.placement",
          "featureFile": "tooling/dshx/e2e/features/editor.feature"
        },
        {
          "kind": "gherkin",
          "id": "editor.open-file-links-native-row",
          "featureFile": "tooling/dshx/e2e/features/settings-shell.feature"
        },
        {
          "kind": "unit-test",
          "id": "editor.workspace-editor-unit-atomic-new-file",
          "file": "plugins/@dshfiles/editor/src/write-file.test.ts",
          "testName": "creates a new file without leaving temp siblings"
        },
        {
          "kind": "unit-test",
          "id": "editor.workspace-editor-unit-hash-checked-save",
          "file": "plugins/@dshfiles/editor/src/write-file.test.ts",
          "testName": "replaces a file whose disk content still matches what the editor loaded, keeping its mode"
        },
        {
          "kind": "unit-test",
          "id": "editor.workspace-editor-unit-disk-conflict",
          "file": "plugins/@dshfiles/editor/src/write-file.test.ts",
          "testName": "reports a conflict and leaves the file alone when it changed on disk"
        },
        {
          "kind": "unit-test",
          "id": "editor.workspace-editor-unit-explicit-overwrite",
          "file": "plugins/@dshfiles/editor/src/write-file.test.ts",
          "testName": "overwrites a conflicting file once the user chose to"
        },
        {
          "kind": "unit-test",
          "id": "editor.workspace-editor-unit-outside-root-rejected",
          "file": "plugins/@dshfiles/editor/src/write-file.test.ts",
          "testName": "refuses an absolute path outside the workspace"
        },
        {
          "kind": "unit-test",
          "id": "editor.workspace-editor-unit-symlink-escape-rejected",
          "file": "plugins/@dshfiles/editor/src/write-file.test.ts",
          "testName": "refuses a symlinked directory that leads outside the workspace"
        },
        {
          "kind": "unit-test",
          "id": "editor.workspace-editor-unit-write-limits",
          "file": "plugins/@dshfiles/editor/src/write-file.test.ts",
          "testName": "refuses directories, missing parents, oversized content and version-control internals"
        },
        {
          "kind": "unit-test",
          "id": "editor.workspace-editor-unit-symlink-prefix-root",
          "file": "plugins/@dshfiles/editor/src/write-file.test.ts",
          "testName": "accepts a root reached through a symlinked prefix"
        }
      ],
      "telemetry": [
        {
          "kind": "automatic",
          "source": "api-dispatch"
        }
      ]
    },
    {
      "id": "workspace-file-index",
      "title": "Index workspace files with bounded traversal",
      "summary": "Traverse breadth-first with concurrency and entry limits, skipping VCS and dependency directories while surfacing partial results.",
      "surfaces": ["host", "integration"],
      "configuration": [],
      "states": ["complete", "truncated", "directory-skipped", "stale-index"],
      "failureModes": ["Unreadable directories are skipped with partial results.", "A stale index is refreshed before searching."],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "editor.file-index-bounds",
          "featureFile": "tooling/dshx/e2e/features/editor.feature"
        },
        {
          "kind": "unit-test",
          "id": "editor.workspace-file-index-unit-breadth-first-exclusions",
          "file": "plugins/@dshfiles/editor/src/workspace-files.test.ts",
          "testName": "lists files breadth-first, skips .git/.jj/node_modules and directories it cannot list"
        },
        {
          "kind": "unit-test",
          "id": "editor.workspace-file-index-unit-truncation-cap",
          "file": "plugins/@dshfiles/editor/src/workspace-files.test.ts",
          "testName": "stops at the file cap and reports truncation"
        },
        {
          "kind": "unit-test",
          "id": "editor.workspace-file-index-unit-fresh-cache",
          "file": "plugins/@dshfiles/editor/src/workspace-files.test.ts",
          "testName": "answers indexing, then ready, and serves a fresh index without walking again"
        }
      ],
      "telemetry": [
        {
          "kind": "automatic",
          "source": "api-dispatch"
        }
      ]
    }
  ],
  "kind": "bundle"
}
