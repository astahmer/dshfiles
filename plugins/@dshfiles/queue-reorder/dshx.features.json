{
  "schemaVersion": 1,
  "features": [
    {
      "id": "queue-ordering",
      "title": "Reorder pending messages",
      "summary": "Move a queued item up, down, or by drag while preserving its durable identity and respecting next-turn and next-step boundaries.",
      "surfaces": [
        "client",
        "host",
        "integration"
      ],
      "configuration": [
        {
          "key": "expandByDefault",
          "defaultValue": "true",
          "constraints": "Boolean; choose the initial queue dock expansion state.",
          "choices": [
            "true",
            "false"
          ],
          "coveredBy": [
            "queue-reorder.dock-preferences"
          ]
        }
      ],
      "states": [
        "collapsed",
        "expanded",
        "moving",
        "idle",
        "busy",
        "failed"
      ],
      "failureModes": [
        "Move at the first/last boundary is a no-op.",
        "A missing item or absent live agent rejects mutation without changing order."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "queue-reorder.move-message",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "gherkin",
          "id": "queue-reorder.drag-target",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "gherkin",
          "id": "queue-reorder.dock-preferences",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "unit-test",
          "id": "queue-reorder.queue-ordering-unit-move-preserves-identity",
          "file": "plugins/@dshfiles/queue-reorder/src/queue-order.test.ts",
          "testName": "moves an item one position as a remove plus an insert, keeping its identity"
        },
        {
          "kind": "unit-test",
          "id": "queue-reorder.queue-ordering-unit-move-boundaries",
          "file": "plugins/@dshfiles/queue-reorder/src/queue-order.test.ts",
          "testName": "leaves an item at either end in place without splicing"
        },
        {
          "kind": "unit-test",
          "id": "queue-reorder.queue-ordering-unit-next-step-location",
          "file": "plugins/@dshfiles/queue-reorder/src/queue-order.test.ts",
          "testName": "finds an item in the next-step list"
        },
        {
          "kind": "unit-test",
          "id": "queue-reorder.queue-ordering-unit-stale-queue-item",
          "file": "plugins/@dshfiles/queue-reorder/src/queue-order.test.ts",
          "testName": "reports an item that is no longer pending"
        }
      ]
    },
    {
      "id": "text-only-message-editing",
      "title": "Edit pending text messages",
      "summary": "Edit only non-empty text-only queue messages and refuse blank content or attachments.",
      "surfaces": [
        "client",
        "host"
      ],
      "configuration": [],
      "states": [
        "viewing",
        "editing",
        "saving",
        "failed"
      ],
      "failureModes": [
        "An attachment or non-text payload prevents editing.",
        "An empty draft is not saved."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "queue-reorder.busy-locks",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "unit-test",
          "id": "queue-reorder.text-only-message-editing-unit-editable-text-only",
          "file": "plugins/@dshfiles/queue-reorder/src/queue-edit.test.ts",
          "testName": "decodeQueuedRows tolerates malformed rows and marks unknown blocks as not editable"
        },
        {
          "kind": "unit-test",
          "id": "queue-reorder.text-only-message-editing-unit-reject-attachments-and-empty",
          "file": "plugins/@dshfiles/queue-reorder/src/queue-edit.test.ts",
          "testName": "editableQueueText rejects attachments and blank content"
        },
        {
          "kind": "unit-test",
          "id": "queue-reorder.text-only-message-editing-unit-host-queue-edit-action",
          "file": "plugins/@dshfiles/queue-reorder/src/queue-editor-rendering.test.ts",
          "testName": "queue edit uses the Host queue action instead of composer-only APIs"
        }
      ]
    },
    {
      "id": "queued-message-preview",
      "title": "Preview queued message text",
      "summary": "Show a normalized one-line text preview, hide attachment payloads, and honor the configured character limit without splitting Unicode code points.",
      "surfaces": [
        "client"
      ],
      "configuration": [
        {
          "key": "previewLength",
          "defaultValue": "200",
          "constraints": "Integer from 40 to 1000 characters.",
          "coveredBy": [
            "queue-reorder.message-preview"
          ]
        }
      ],
      "states": [
        "text-preview",
        "truncated-preview",
        "attachment-only",
        "empty-preview"
      ],
      "failureModes": [
        "Text previews split a Unicode code point during truncation.",
        "Image or file payload data is rendered as message text."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "queue-reorder.message-preview",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "unit-test",
          "id": "queue-reorder.queued-message-preview-unit-normalizes-and-hides-attachments",
          "file": "plugins/@dshfiles/queue-reorder/src/message-preview.test.ts",
          "testName": "flattens text and named blocks while excluding attachments"
        },
        {
          "kind": "unit-test",
          "id": "queue-reorder.queued-message-preview-unit-unicode-safe-limit",
          "file": "plugins/@dshfiles/queue-reorder/src/message-preview.test.ts",
          "testName": "clips by Unicode code point and appends one ellipsis"
        }
      ]
    }
  ],
  "kind": "bundle"
}
