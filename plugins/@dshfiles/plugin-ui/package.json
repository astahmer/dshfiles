{
  "name": "@dshfiles/plugin-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared UI for dshfiles DSH plugins: gap components over the Host primitives, plus TanStack Query, Table, Form, and Charts bindings.",
  "type": "module",
  "exports": {
    "./components/ui/*": {
      "types": "./src/components/ui/*.tsx",
      "default": "./src/components/ui/*.tsx"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./lib/utils": {
      "types": "./src/lib/utils.ts",
      "default": "./src/lib/utils.ts"
    },
    "./lib/host-request": {
      "types": "./src/lib/host-request.ts",
      "default": "./src/lib/host-request.ts"
    },
    "./icons": {
      "types": "./src/icons.ts",
      "default": "./src/icons.ts"
    },
    "./styles.css": "./src/styles.css",
    "./vite": {
      "types": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./query": {
      "types": "./src/query.tsx",
      "default": "./src/query.tsx"
    },
    "./table": {
      "types": "./src/table.tsx",
      "default": "./src/table.tsx"
    },
    "./form": {
      "types": "./src/form.tsx",
      "default": "./src/form.tsx"
    },
    "./machine": {
      "types": "./src/machine.ts",
      "default": "./src/machine.ts"
    },
    "./chart": {
      "types": "./src/chart.tsx",
      "default": "./src/chart.tsx"
    },
    "./diff": {
      "types": "./src/diff.tsx",
      "default": "./src/diff.tsx"
    },
    "./virtual": {
      "types": "./src/virtual.ts",
      "default": "./src/virtual.ts"
    },
    "./testing/host-primitives": {
      "types": "./testing/host-primitives.tsx",
      "default": "./testing/host-primitives.tsx"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pierre/diffs": "1.5.2",
    "@shikijs/langs": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/charts": "1.0.0",
    "@tanstack/query-core": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.13",
    "@xstate/react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "lucide-react": "1.48.0",
    "radix-ui": "1.7.0",
    "react-resizable-panels": "4.14.2",
    "shiki": "4.5.0",
    "tailwind-merge": "catalog:",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "xstate": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@dshfiles/dshx": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "22.20.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <0.3.0-0",
    "react": ">=18.2.0 <19",
    "react-dom": ">=18.2.0 <19"
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
