{
  "name": "@dshfiles/plugin-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared UI for dshfiles DSH plugins: gap components over the Host primitives, plus TanStack Query, Table, Form, and Charts bindings.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./query": {
      "types": "./src/query.tsx",
      "default": "./src/query.tsx"
    },
    "./table": {
      "types": "./src/table.tsx",
      "default": "./src/table.tsx"
    },
    "./form": {
      "types": "./src/form.tsx",
      "default": "./src/form.tsx"
    },
    "./chart": {
      "types": "./src/chart.tsx",
      "default": "./src/chart.tsx"
    },
    "./testing/host-primitives": {
      "types": "./testing/host-primitives.tsx",
      "default": "./testing/host-primitives.tsx"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/charts": "1.0.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@dshfiles/dshx": "link:../../../tooling/dshx/packages/dshx",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.19.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <0.3.0-0",
    "react": ">=18.2.0 <19",
    "react-dom": ">=18.2.0 <19"
  }
}
