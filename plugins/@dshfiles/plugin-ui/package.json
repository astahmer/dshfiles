{
  "name": "@dshfiles/plugin-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared UI for dshfiles DSH plugins: gap components over the Host primitives, plus TanStack Query, Table, Form, and Charts bindings.",
  "type": "module",
  "exports": {
    "./components/ui/*": {
      "types": "./src/components/ui/*.tsx",
      "default": "./src/components/ui/*.tsx"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./lib/utils": {
      "types": "./src/lib/utils.ts",
      "default": "./src/lib/utils.ts"
    },
    "./icons": {
      "types": "./src/icons.ts",
      "default": "./src/icons.ts"
    },
    "./styles.css": "./src/styles.css",
    "./vite": {
      "types": "./src/vite.ts",
      "default": "./src/vite.ts"
    },
    "./query": {
      "types": "./src/query.tsx",
      "default": "./src/query.tsx"
    },
    "./table": {
      "types": "./src/table.tsx",
      "default": "./src/table.tsx"
    },
    "./form": {
      "types": "./src/form.tsx",
      "default": "./src/form.tsx"
    },
    "./chart": {
      "types": "./src/chart.tsx",
      "default": "./src/chart.tsx"
    },
    "./testing/host-primitives": {
      "types": "./testing/host-primitives.tsx",
      "default": "./testing/host-primitives.tsx"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/charts": "1.0.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.48.0",
    "radix-ui": "1.7.0",
    "react-resizable-panels": "4.14.2",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@dshfiles/dshx": "link:../../../tooling/dshx/packages/dshx",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.19.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.0-rc.1 <0.3.0-0",
    "react": ">=18.2.0 <19",
    "react-dom": ">=18.2.0 <19"
  }
}
