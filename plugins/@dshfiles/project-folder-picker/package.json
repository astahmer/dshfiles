{
  "name": "@dshfiles/project-folder-picker",
  "version": "0.1.0",
  "private": true,
  "description": "React picker for registered DSH projects and Host folders, shared by owned bundles.",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dshfiles/plugin-ui": "workspace:*"
  },
  "devDependencies": {
    "@dshfiles/dshx": "workspace:*",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <19"
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
