{
  "schemaVersion": 1,
  "features": [
    {
      "id": "review-file-markers",
      "title": "Mark review files as viewed",
      "summary": "Toggle viewed state for one file in one review-session change and show the viewed progress count.",
      "surfaces": ["client", "api", "storage"],
      "configuration": [],
      "states": ["unviewed", "viewed", "progress-updated"],
      "failureModes": [
        "An invalid review action URL hides the control.",
        "A malformed or unavailable summary hides progress instead of displaying invented state."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "diff-viewed.toggle-progress",
          "featureFile": "tooling/dshx/e2e/features/diff-viewed.feature"
        },
        {
          "kind": "gherkin",
          "id": "diff-viewed.change-scope",
          "featureFile": "tooling/dshx/e2e/features/diff-viewed.feature"
        },
        {
          "kind": "unit-test",
          "id": "diff-viewed.review-file-markers-unit-route-coordinates",
          "file": "plugins/@dshfiles/diff-viewed/src/review-file.test.ts",
          "testName": "reads the session, sequence and index from the review tab action route"
        },
        {
          "kind": "unit-test",
          "id": "diff-viewed.review-file-markers-unit-malformed-route",
          "file": "plugins/@dshfiles/diff-viewed/src/review-file.test.ts",
          "testName": "refuses a route without a query or with a malformed index"
        },
        {
          "kind": "unit-test",
          "id": "diff-viewed.review-file-markers-unit-summary-files",
          "file": "plugins/@dshfiles/diff-viewed/src/review-file.test.ts",
          "testName": "keeps the listed files of a served summary"
        },
        {
          "kind": "unit-test",
          "id": "diff-viewed.review-file-markers-unit-invalid-summary",
          "file": "plugins/@dshfiles/diff-viewed/src/review-file.test.ts",
          "testName": "refuses a body that is not a summary"
        },
        {
          "kind": "unit-test",
          "id": "diff-viewed.review-file-markers-unit-persisted-toggle",
          "file": "plugins/@dshfiles/diff-viewed/src/viewed-marks.test.ts",
          "testName": "toggles a file and persists the mark"
        },
        {
          "kind": "unit-test",
          "id": "diff-viewed.review-file-markers-unit-turn-scope",
          "file": "plugins/@dshfiles/diff-viewed/src/viewed-marks.test.ts",
          "testName": "keeps a mark to its own turn"
        }
      ],
      "telemetry": [
        {
          "kind": "automatic",
          "source": "api-dispatch"
        }
      ]
    },
    {
      "id": "host-owned-view-state",
      "title": "Retain viewed marks on the Host",
      "summary": "Keep the marks in the Host's durable diff_viewed domain, capped at the 2000 most recent, fall back to browser-held marks until the Host serves the API, and adopt those browser marks once.",
      "surfaces": ["host", "api", "storage", "client"],
      "configuration": [],
      "states": ["host-owned", "browser-fallback", "legacy-adopted", "retention-evicted"],
      "failureModes": [
        "A full retention cap evicts the oldest mark.",
        "An older Host without the API keeps the browser-held marks working.",
        "A malformed stored mark reads as unviewed instead of crashing the panel."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "diff-viewed.storage-retention",
          "featureFile": "tooling/dshx/e2e/features/diff-viewed.feature"
        },
        {
          "kind": "gherkin",
          "id": "diff-viewed.cross-tab",
          "featureFile": "tooling/dshx/e2e/features/diff-viewed.feature"
        },
        {
          "kind": "unit-test",
          "id": "diff-viewed.host-owned-view-state-unit-corrupt-storage",
          "file": "plugins/@dshfiles/diff-viewed/src/viewed-marks.test.ts",
          "testName": "starts empty when the stored value is corrupt"
        },
        {
          "kind": "unit-test",
          "id": "diff-viewed.host-owned-view-state-unit-retention-cap",
          "file": "plugins/@dshfiles/diff-viewed/src/viewed-marks.test.ts",
          "testName": "evicts the oldest marks beyond the cap"
        },
        {
          "kind": "unit-test",
          "id": "diff-viewed.host-owned-view-state-unit-cross-window-reload",
          "file": "plugins/@dshfiles/diff-viewed/src/viewed-marks.test.ts",
          "testName": "adopts marks another window wrote when reloaded"
        },
        {
          "kind": "unit-test",
          "id": "diff-viewed.host-owned-view-state-unit-subscriber-snapshot",
          "file": "plugins/@dshfiles/diff-viewed/src/viewed-marks.test.ts",
          "testName": "notifies subscribers with a new snapshot identity"
        },
        {
          "kind": "unit-test",
          "id": "diff-viewed.host-owned-view-state-unit-durable-mark",
          "file": "plugins/@dshfiles/diff-viewed/src/marks-store.test.ts",
          "testName": "a mark is stored durably and belongs to its own turn"
        },
        {
          "kind": "unit-test",
          "id": "diff-viewed.host-owned-view-state-unit-retention-trim",
          "file": "plugins/@dshfiles/diff-viewed/src/marks-store.test.ts",
          "testName": "the oldest marks are trimmed past the bound"
        },
        {
          "kind": "host-test",
          "id": "diff-viewed.host-owned-view-state-host-domain-wiring",
          "file": "plugins/@dshfiles/diff-viewed/src/host.test.ts",
          "testName": "opens the durable marks domain and closes it on unload"
        }
      ],
      "telemetry": [
        {
          "kind": "automatic",
          "source": "api-dispatch"
        }
      ]
    }
  ],
  "kind": "bundle"
}
