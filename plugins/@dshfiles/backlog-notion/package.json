{
  "name": "@dshfiles/backlog-notion",
  "version": "0.1.0",
  "private": true,
  "description": "Notion data sources as a backlog sync provider: pages, status, tags, priority, parent, markdown bodies and comments.",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "build": "dshx build",
    "check": "dshx check && pnpm lint && pnpm fmt:check",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint src dshx.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin",
    "test:e2e": "node ../../../tooling/dshx/scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@dshfiles/backlog": "workspace:*",
    "@dshfiles/credential-port": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@dshfiles/dshx": "workspace:*",
    "@effect/vitest": "catalog:",
    "@types/node": "22.20.5",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "@dshfiles/backlog": ">=0.1.0 <0.2.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
