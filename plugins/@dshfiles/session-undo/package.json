{
  "name": "@dshfiles/session-undo",
  "version": "0.1.0",
  "private": true,
  "description": "Undo and redo a thread's last turn: the conversation forks back before it and the workspace files return to their snapshot, through the VCS provider (jj operations in a jj workspace).",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./dist/client.js"
  },
  "scripts": {
    "build": "node ../../../tooling/dshx/packages/dshx/dist/cli/bin.js build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin"
  },
  "dependencies": {
    "@dshfiles/plugin-ui": "workspace:*",
    "@dshfiles/shared-runtime": "workspace:*",
    "@dshfiles/vcs-provider-port": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-client-ui-workspace": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-storage-domain": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-workspace": "catalog:",
    "@dshfiles/dshx": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "host": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-session",
        "@deepseek-ai/dsh-storage-domain",
        "@deepseek-ai/dsh-tools",
        "@deepseek-ai/dsh-workspace"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "locales": [
        "dshfiles.sessionUndo"
      ],
      "external": [
        "@dshfiles/shared-runtime"
      ]
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
