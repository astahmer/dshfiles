{
  "name": "@dshfiles/chat",
  "version": "0.1.0",
  "private": true,
  "description": "Owned fork of DSH's native Chat plugin that mounts only the transcript rows near the viewport.",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "LICENSE",
    "README.md",
    "dshx.features.json"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "dshx build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-api-session-controller": "catalog:",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "catalog:",
    "@deepseek-ai/dsh-client-product-analytics": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "catalog:",
    "@deepseek-ai/dsh-client-ui-approval": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "catalog:",
    "@deepseek-ai/dsh-client-ui-conversation": "catalog:",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "catalog:",
    "@deepseek-ai/dsh-client-ui-primitives": "catalog:",
    "@deepseek-ai/dsh-client-ui-renderer": "catalog:",
    "@deepseek-ai/dsh-client-ui-session": "catalog:",
    "@deepseek-ai/dsh-client-ui-settings": "catalog:",
    "@deepseek-ai/dsh-client-ui-sidebar-browser": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-client-ui-workspace": "catalog:",
    "@deepseek-ai/dsh-commands": "catalog:",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-llm-retry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-stats": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-turn-outline": "catalog:",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@deepseek-ai/dsh-util-crypto": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "catalog:",
    "@dshfiles/dshx": "workspace:*",
    "@tanstack/react-virtual": "3.14.13",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "external": [
        "@deepseek-ai/dsh-client-store",
        "@tanstack/react-virtual"
      ],
      "immediately": false
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
