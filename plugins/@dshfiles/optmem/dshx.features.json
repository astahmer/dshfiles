{
  "schemaVersion": 1,
  "features": [
    {
      "id": "conversation-capture",
      "title": "Capture eligible conversation and tool activity",
      "summary": "Persist eligible human, assistant, and tool activity with bounded redaction, replay deduplication, exclusion markers, and optional subagent capture.",
      "surfaces": [
        "host",
        "storage",
        "settings",
        "integration"
      ],
      "configuration": [
        {
          "key": "enabled",
          "defaultValue": "true",
          "constraints": "Boolean; disable capture and memory use.",
          "choices": [
            "true",
            "false"
          ],
          "coveredBy": [
            "optmem.capture-dedup"
          ]
        },
        {
          "key": "captureSubagents",
          "defaultValue": "true",
          "constraints": "Boolean; capture eligible subagent activity.",
          "choices": [
            "true",
            "false"
          ],
          "coveredBy": [
            "optmem.capture-dedup"
          ]
        },
        {
          "key": "excludedTools",
          "defaultValue": "[]",
          "constraints": "Tool-name list whose input and output are excluded from capture.",
          "coveredBy": [
            "optmem.exclusions"
          ]
        },
        {
          "key": "excludedPaths",
          "defaultValue": "[**/.env, **/.env.*, **/*.pem, **/*.key, **/id_rsa*, **/.ssh/**]",
          "constraints": "Glob list applied before capture; sensitive defaults must remain excluded.",
          "coveredBy": [
            "optmem.exclusions"
          ]
        }
      ],
      "states": [
        "captured",
        "deduplicated",
        "excluded-marker",
        "disabled"
      ],
      "failureModes": [
        "Injected context and checkpoints are skipped.",
        "Excluded tool/path content is represented only by a marker and never copied into memory."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "optmem.capture-dedup",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "gherkin",
          "id": "optmem.exclusions",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "unit-test",
          "id": "optmem.conversation-capture-unit-event-deduplication",
          "file": "plugins/@dshfiles/optmem/src/optmem.test.ts",
          "testName": "stores user, assistant text, tool calls and results once, even when DSH re-delivers them"
        },
        {
          "kind": "unit-test",
          "id": "optmem.conversation-capture-unit-injected-context-exclusion",
          "file": "plugins/@dshfiles/optmem/src/optmem.test.ts",
          "testName": "skips injected context (runtime, instructions, skills) and compaction checkpoints"
        },
        {
          "kind": "unit-test",
          "id": "optmem.conversation-capture-unit-subagent-scope",
          "file": "plugins/@dshfiles/optmem/src/optmem.test.ts",
          "testName": "maps a subagent to its own conversation linked to the parent, and can leave subagents out"
        },
        {
          "kind": "unit-test",
          "id": "optmem.conversation-capture-unit-sensitive-exclusion-markers",
          "file": "plugins/@dshfiles/optmem/src/optmem.test.ts",
          "testName": "keeps only a marker for excluded tools and for calls naming an excluded path, results included"
        }
      ]
    },
    {
      "id": "bounded-context-injection",
      "title": "Inject bounded same-project memory context",
      "summary": "Inject compact, bounded summaries into eligible prompts, refresh after configured growth, and fall back to compatible mode when a fork-only hook is unavailable.",
      "surfaces": [
        "host",
        "settings",
        "integration"
      ],
      "configuration": [
        {
          "key": "mode",
          "defaultValue": "compat",
          "constraints": "One of compat or full; unsupported full-mode hook reports a compat fallback.",
          "choices": [
            "compat",
            "full"
          ],
          "coveredBy": [
            "optmem.full-fallback"
          ]
        },
        {
          "key": "injectUpperBytes",
          "defaultValue": "8192",
          "constraints": "Integer from 1024 to 65536 bytes.",
          "coveredBy": [
            "optmem.injection-bounds"
          ]
        },
        {
          "key": "injectLowerBytes",
          "defaultValue": "4096",
          "constraints": "Integer from 512 to 65536 bytes.",
          "coveredBy": [
            "optmem.injection-bounds"
          ]
        },
        {
          "key": "injectRefreshBytes",
          "defaultValue": "1024",
          "constraints": "Integer from 0 to 65536 bytes.",
          "coveredBy": [
            "optmem.injection-bounds"
          ]
        },
        {
          "key": "summarizerProvider",
          "defaultValue": "",
          "constraints": "Provider identifier; empty means no configured summarizer.",
          "coveredBy": [
            "optmem.summarizer-failure"
          ]
        },
        {
          "key": "summarizerModel",
          "defaultValue": "gpt-6-luna",
          "constraints": "Non-empty model identifier.",
          "coveredBy": [
            "optmem.summarizer-failure"
          ]
        },
        {
          "key": "summarizerEffort",
          "defaultValue": "low",
          "constraints": "One of low, medium, or high.",
          "choices": [
            "low",
            "medium",
            "high"
          ],
          "coveredBy": [
            "optmem.summarizer-failure"
          ]
        },
        {
          "key": "summarizerConcurrency",
          "defaultValue": "2",
          "constraints": "Integer from 1 to 16 concurrent tasks.",
          "coveredBy": [
            "optmem.summarizer-failure"
          ]
        },
        {
          "key": "summarizerTimeoutMs",
          "defaultValue": "60000",
          "constraints": "Integer from 1000 to 600000 milliseconds.",
          "coveredBy": [
            "optmem.summarizer-failure"
          ]
        },
        {
          "key": "barrierMs",
          "defaultValue": "5000",
          "constraints": "Integer from 0 to 60000 milliseconds.",
          "coveredBy": [
            "optmem.barrier-cancel"
          ]
        }
      ],
      "states": [
        "compat",
        "full",
        "summary-pending",
        "injected",
        "cancelled",
        "fallback"
      ],
      "failureModes": [
        "Unavailable summarizer leaves pending raw summaries for retry.",
        "Cancellation preserves the durable barrier marker and does not inject stale context.",
        "The stock Host cannot claim fork-only full mode is active."
      ],
      "externalDependencies": [
        {
          "id": "summarizer-provider",
          "boundary": "Optional external model summarization provider.",
          "deterministicFake": "Inject a synthetic gated summarizer and fake clock; routine tests never call a paid LLM or use account credentials."
        }
      ],
      "verification": [
        {
          "kind": "gherkin",
          "id": "optmem.injection-bounds",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "gherkin",
          "id": "optmem.full-fallback",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "gherkin",
          "id": "optmem.summarizer-failure",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "gherkin",
          "id": "optmem.barrier-cancel",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "unit-test",
          "id": "optmem.bounded-context-injection-unit-stock-host-fallback",
          "file": "plugins/@dshfiles/optmem/src/full-mode.test.ts",
          "testName": "stays in compatibility mode on stock DSH"
        },
        {
          "kind": "unit-test",
          "id": "optmem.bounded-context-injection-unit-fork-mode",
          "file": "plugins/@dshfiles/optmem/src/full-mode.test.ts",
          "testName": "reports full mode when the fork request-messages hook is present"
        },
        {
          "kind": "unit-test",
          "id": "optmem.bounded-context-injection-unit-current-turn-context",
          "file": "plugins/@dshfiles/optmem/src/full-mode.test.ts",
          "testName": "sends system, instructions, the memory view and only the current turn, with a stable prefix inside a turn"
        },
        {
          "kind": "unit-test",
          "id": "optmem.bounded-context-injection-unit-pending-summary-lines",
          "file": "plugins/@dshfiles/optmem/src/full-mode.test.ts",
          "testName": "renders events still waiting for a summary as pending lines after the barrier"
        },
        {
          "kind": "unit-test",
          "id": "optmem.bounded-context-injection-unit-barrier-cancellation",
          "file": "plugins/@dshfiles/optmem/src/full-mode.test.ts",
          "testName": "rejects with the abort reason when the turn is cancelled during the barrier"
        },
        {
          "kind": "unit-test",
          "id": "optmem.bounded-context-injection-unit-stock-request-identity",
          "file": "plugins/@dshfiles/optmem/src/full-mode.test.ts",
          "testName": "leaves requests untouched without the fork hook"
        },
        {
          "kind": "unit-test",
          "id": "optmem.bounded-context-injection-unit-compact-project-view",
          "file": "plugins/@dshfiles/optmem/src/optmem.test.ts",
          "testName": "injects the compact project view without lines that only repeat the reading conversation"
        },
        {
          "kind": "unit-test",
          "id": "optmem.bounded-context-injection-unit-view-budget",
          "file": "plugins/@dshfiles/optmem/src/optmem.test.ts",
          "testName": "keeps the injected view within its budget once the project outgrows it"
        }
      ]
    },
    {
      "id": "scoped-memory-tools",
      "title": "Search and inspect scoped memory",
      "summary": "Expose bounded search, zoom, context, and status tools while keeping project scope isolated unless cross-project access is explicitly enabled.",
      "surfaces": [
        "host",
        "tool",
        "storage",
        "settings"
      ],
      "configuration": [
        {
          "key": "viewUpperBytes",
          "defaultValue": "128000",
          "constraints": "Integer from 4096 to 1048576 bytes.",
          "coveredBy": [
            "optmem.recall-scope"
          ]
        },
        {
          "key": "viewLowerBytes",
          "defaultValue": "64000",
          "constraints": "Integer from 2048 to 1048576 bytes.",
          "coveredBy": [
            "optmem.recall-scope"
          ]
        },
        {
          "key": "maxNodeBytes",
          "defaultValue": "512",
          "constraints": "Integer from 128 to 4096 bytes per node.",
          "coveredBy": [
            "optmem.recall-scope"
          ]
        },
        {
          "key": "toolResultCap",
          "defaultValue": "16384",
          "constraints": "Integer from 1024 to 262144 bytes.",
          "coveredBy": [
            "optmem.recall-scope"
          ]
        },
        {
          "key": "allowAllProjects",
          "defaultValue": "false",
          "constraints": "Boolean; permit cross-project reads only when opted in.",
          "choices": [
            "true",
            "false"
          ],
          "coveredBy": [
            "optmem.recall-scope"
          ]
        }
      ],
      "states": [
        "empty",
        "same-project-results",
        "zoomed",
        "context-built",
        "cross-project-denied",
        "cross-project-enabled"
      ],
      "failureModes": [
        "A cross-project query is denied by default.",
        "Database failure reports failed status while leaving the Host responsive."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "optmem.recall-scope",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "gherkin",
          "id": "optmem.database-failure",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "unit-test",
          "id": "optmem.scoped-memory-tools-unit-same-project-recall",
          "file": "plugins/@dshfiles/optmem/src/optmem.test.ts",
          "testName": "recalls another conversation of the same project, then zooms and shows context"
        },
        {
          "kind": "unit-test",
          "id": "optmem.scoped-memory-tools-unit-cross-project-denied",
          "file": "plugins/@dshfiles/optmem/src/optmem.test.ts",
          "testName": "hides other projects unless all-projects retrieval is enabled"
        },
        {
          "kind": "unit-test",
          "id": "optmem.scoped-memory-tools-unit-disabled-memory-error",
          "file": "plugins/@dshfiles/optmem/src/optmem.test.ts",
          "testName": "reports a disabled or missing memory as a clear tool error"
        },
        {
          "kind": "unit-test",
          "id": "optmem.scoped-memory-tools-unit-store-failure-isolation",
          "file": "plugins/@dshfiles/optmem/src/optmem.test.ts",
          "testName": "never throws into DSH when the store breaks under it"
        },
        {
          "kind": "unit-test",
          "id": "optmem.scoped-memory-tools-unit-database-open-failure",
          "file": "plugins/@dshfiles/optmem/src/optmem.test.ts",
          "testName": "degrades to a failed state when the database cannot be opened"
        },
        {
          "kind": "unit-test",
          "id": "optmem.scoped-memory-tools-unit-read-only-storage",
          "file": "plugins/@dshfiles/optmem/src/optmem.test.ts",
          "testName": "survives a read-only memory directory"
        }
      ]
    }
  ],
  "kind": "bundle"
}
