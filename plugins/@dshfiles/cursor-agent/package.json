{
  "name": "@dshfiles/cursor-agent",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "dshx check && pnpm lint && pnpm fmt:check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src tests dshx.config.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "dshx test",
    "build": "dshx build",
    "dev": "dshx dev --open",
    "prepack": "npm run check && npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "link:../../../tooling/dsh-core/agent",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@dshfiles/dshx": "link:../../../tooling/dshx/packages/dshx",
    "@types/node": "^22.19.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
