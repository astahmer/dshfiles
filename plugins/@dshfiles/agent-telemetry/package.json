{
  "name": "@dshfiles/agent-telemetry",
  "version": "0.1.0",
  "private": true,
  "description": "OpenTelemetry GenAI spans for DSH turns, steps, model calls and tools, exported through dshx tracing; forked from @loongsuite/dsh-plugin.",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "scripts": {
    "build": "dshx build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin",
    "test:e2e": "node ../../../tooling/dshx/scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "catalog:",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@dshfiles/ai-accounts": "workspace:*",
    "@dshfiles/dshx": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
