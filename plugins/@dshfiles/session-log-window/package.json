{
  "name": "@dshfiles/session-log-window",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded reads of a stored Session log: its newest frames, its first frames, and the projection checkpoint folded over them, so a reader that needs a few events never decodes the whole log.",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "dshx.features.json"
  ],
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --run build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "catalog:",
    "@deepseek-ai/dsh-session-projection-cache": "0.2.1-rc.2",
    "@dshfiles/dshx": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-projection-cache": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
