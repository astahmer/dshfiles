{
  "schemaVersion": 1,
  "features": [
    {
      "id": "thread-classification",
      "title": "Organize threads by workspace and status",
      "summary": "Group active, pinned, parked, inactive, and archived threads by project; park with sidebar preferences and pin/archive through Host APIs.",
      "surfaces": ["client", "host", "settings", "storage", "integration"],
      "configuration": [
        {
          "key": "threadRowDensity",
          "defaultValue": "compact",
          "constraints": "One of compact or comfortable.",
          "choices": ["compact", "comfortable"],
          "coveredBy": ["thread-sidebar.classification"]
        },
        {
          "key": "threadRowProject",
          "defaultValue": "true",
          "constraints": "Boolean; show project labels.",
          "choices": ["true", "false"],
          "coveredBy": ["thread-sidebar.classification"]
        },
        {
          "key": "threadRowProjectColor",
          "defaultValue": "true",
          "constraints": "Boolean; color project labels.",
          "choices": ["true", "false"],
          "coveredBy": ["thread-sidebar.classification"]
        },
        {
          "key": "threadRowTitle",
          "defaultValue": "true",
          "constraints": "Boolean; show thread titles.",
          "choices": ["true", "false"],
          "coveredBy": ["thread-sidebar.classification"]
        },
        {
          "key": "threadRowMachine",
          "defaultValue": "true",
          "constraints": "Boolean; show machine labels.",
          "choices": ["true", "false"],
          "coveredBy": ["thread-sidebar.classification"]
        },
        {
          "key": "threadRowPath",
          "defaultValue": "false",
          "constraints": "Boolean; show workspace paths.",
          "choices": ["true", "false"],
          "coveredBy": ["thread-sidebar.classification"]
        },
        {
          "key": "threadRowTime",
          "defaultValue": "true",
          "constraints": "Boolean; show thread activity time.",
          "choices": ["true", "false"],
          "coveredBy": ["thread-sidebar.classification"]
        },
        {
          "key": "threadRowStatusDot",
          "defaultValue": "true",
          "constraints": "Boolean; show thread status indicator.",
          "choices": ["true", "false"],
          "coveredBy": ["thread-sidebar.classification"]
        },
        {
          "key": "attentionColors",
          "defaultValue": "{\"approvalNeeded\":\"warning\",\"inputNeeded\":\"info\",\"turnFinished\":\"success\"}",
          "constraints": "Each status independently chooses one of muted, primary, info, success, warning, or danger semantic colors.",
          "choices": ["muted", "primary", "info", "success", "warning", "danger"],
          "coveredBy": ["thread-sidebar.attention-colors"]
        },
        {
          "key": "attentionColors",
          "defaultValue": "{\"approvalNeeded\":\"warning\",\"inputNeeded\":\"warning\",\"turnFinished\":\"success\"}",
          "constraints": "Each status independently chooses one of muted, primary, info, success, warning, or danger semantic colors.",
          "coveredBy": [
            "thread-sidebar.attention-colors"
          ]
        },
        {
          "key": "parkedSessionIds",
          "defaultValue": "[]",
          "constraints": "Parked session IDs in sidebar preferences; not updated through Host session attention.",
          "coveredBy": ["thread-sidebar.classification"]
        },
        {
          "key": "applyActionsToChildThreads",
          "defaultValue": "true",
          "constraints": "Boolean; apply manual actions to every descendant when acting on a parent thread.",
          "choices": ["true", "false"],
          "coveredBy": ["thread-sidebar.classification"]
        },
        {
          "key": "collapsedSections",
          "defaultValue": "[archived]",
          "constraints": "Section ID list; archived is collapsed by default.",
          "coveredBy": ["thread-sidebar.classification"]
        }
      ],
      "states": ["active", "pinned", "parked", "inactive", "archived", "failed"],
      "failureModes": [
        "Parking updates sidebar preferences without depending on Host session-attention mutations.",
        "Activity uses session metadata timestamps and may reflect metadata updates.",
        "Latest durable turn failures stay visible until a later non-error turn; errors without a durable turn/end are omitted."
      ],
      "externalDependencies": [],
      "verification": [
