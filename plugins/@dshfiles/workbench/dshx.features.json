{
  "schemaVersion": 1,
  "features": [
    {
      "id": "dockable-panel-layouts",
      "title": "Arrange plugin panels in independent layouts",
      "summary": "Opens on the Editor alone, then adds panels and arranges tab, split, float, move, close, and reset operations independently in the main workbench and right-side pane. The Scratchpad and Ticker docking fixtures appear only behind a developer setting.",
      "reach": ["click button \"Workbench\"", "expect heading \"Workbench\"", "expect region \"Editor\""],
      "surfaces": ["client", "integration", "storage", "settings"],
      "configuration": [
        {
          "key": "headerToggle",
          "defaultValue": "false",
          "constraints": "Boolean; show the workbench header toggle.",
          "choices": ["true", "false"],
          "coveredBy": ["workbench.surface-layouts"]
        },
        {
          "key": "demoPanels",
          "defaultValue": "false",
          "constraints": "Boolean; offer the Scratchpad and Ticker developer fixtures in Add panel.",
          "choices": ["true", "false"],
          "coveredBy": ["workbench.default-layout"]
        }
      ],
      "states": ["tabbed", "split", "floating", "closed", "reset"],
      "failureModes": [
        "Malformed persisted layout falls back to defaults.",
        "An unavailable registered plugin remains a closable placeholder and recovers when it registers."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "workbench.default-layout",
          "featureFile": "tooling/dshx/e2e/features/workbench.feature"
        },
        {
          "kind": "gherkin",
          "id": "workbench.persisted-layout",
          "featureFile": "tooling/dshx/e2e/features/workbench.feature"
        },
        {
          "kind": "gherkin",
          "id": "workbench.missing-plugin",
          "featureFile": "tooling/dshx/e2e/features/workbench.feature"
        },
        {
          "kind": "gherkin",
          "id": "workbench.surface-layouts",
          "featureFile": "tooling/dshx/e2e/features/workbench.feature"
        },
        {
          "kind": "unit-test",
          "id": "workbench.dockable-panel-layouts-unit-editor-default-layout",
          "file": "plugins/@dshfiles/workbench/src/workbench-view.test.tsx",
          "testName": "opens the Editor alone by default and leaves the other panels to Add panel"
        },
        {
          "kind": "unit-test",
          "id": "workbench.dockable-panel-layouts-unit-default-split-layout",
          "file": "plugins/@dshfiles/workbench/src/workbench-view.test.tsx",
          "testName": "opens the first two registered panels side by side by default"
        },
        {
          "kind": "unit-test",
          "id": "workbench.dockable-panel-layouts-unit-layout-restoration",
          "file": "plugins/@dshfiles/workbench/src/workbench-view.test.tsx",
          "testName": "restores the saved layout after a reload"
        },
        {
          "kind": "unit-test",
          "id": "workbench.dockable-panel-layouts-unit-missing-panel-placeholder",
          "file": "plugins/@dshfiles/workbench/src/workbench-view.test.tsx",
          "testName": "keeps a saved panel whose plugin is gone as a closable placeholder that recovers on registration"
        },
        {
          "kind": "unit-test",
          "id": "workbench.dockable-panel-layouts-unit-invalid-layout-fallback",
          "file": "plugins/@dshfiles/workbench/src/workbench-view.test.tsx",
          "testName": "falls back to the default layout when Dockview rejects the saved one"
        },
        {
          "kind": "unit-test",
          "id": "workbench.dockable-panel-layouts-unit-side-and-main-storage",
          "file": "plugins/@dshfiles/workbench/src/layout-store.test.ts",
          "testName": "keeps the side-panel layout apart from the main-area one"
        }
      ]
    },
    {
      "id": "early-panel-registration",
      "title": "Queue panel-open requests before mount",
      "summary": "Retain stable panel registrations and early open requests until the matching dock view mounts.",
      "surfaces": ["client", "integration"],
      "configuration": [],
      "states": ["registered", "queued-open", "mounted", "placeholder"],
      "failureModes": ["A duplicate or missing panel identity cannot silently replace another registration."],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "workbench.early-open",
          "featureFile": "tooling/dshx/e2e/features/workbench.feature"
        },
        {
          "kind": "unit-test",
          "id": "workbench.early-panel-registration-unit-queued-open-requests",
          "file": "plugins/@dshfiles/workbench/src/registry.test.ts",
          "testName": "keeps open requests, deduplicated and latest last, until the workbench takes them"
        },
        {
          "kind": "unit-test",
          "id": "workbench.early-panel-registration-unit-open-before-mount",
          "file": "plugins/@dshfiles/workbench/src/workbench-view.test.tsx",
          "testName": "opens a panel another plugin asks for, even when asked before the view mounted"
        },
        {
          "kind": "unit-test",
          "id": "workbench.early-panel-registration-unit-shared-registry-instance",
          "file": "plugins/@dshfiles/workbench/src/registry.test.ts",
          "testName": "shares one page-wide instance across bundles through a global symbol"
        }
      ]
    }
  ],
  "kind": "bundle"
}
