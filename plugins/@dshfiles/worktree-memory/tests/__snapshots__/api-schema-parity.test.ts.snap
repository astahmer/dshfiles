// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`worktree memory API schema parity > keeps the API and agent-tool schemas byte-identical 1`] = `
"{
  "snapshot": {
    "description": "Resident memory of DSH process trees grouped by workspace, plus a deterministic, argv-redacted summary of this user’s Node processes grouped by script label, nearest app or parent, and working directory. Node memory is resident RSS. Includes the memory-pressure level. Read-only.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "takenAt": {
          "type": "number"
        },
        "supported": {
          "type": "boolean"
        },
        "pressure": {
          "type": "string",
          "enum": [
            "normal",
            "warning",
            "critical",
            "unknown"
          ]
        },
        "systemBytes": {
          "type": "number",
          "minimum": 0
        },
        "hostBytes": {
          "type": "number",
          "minimum": 0
        },
        "trackedBytes": {
          "type": "number",
          "minimum": 0
        },
        "detachedBytes": {
          "type": "number",
          "minimum": 0
        },
        "detachedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "categoryBytes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "dev-server",
              "tests",
              "build",
              "dsh",
              "services",
              "other"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          },
          "required": [
            "dev-server",
            "tests",
            "build",
            "dsh",
            "services",
            "other"
          ]
        },
        "groups": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "maxLength": 1024
              },
              "title": {
                "type": "string",
                "maxLength": 300
              },
              "path": {
                "type": "string",
                "maxLength": 1024
              },
              "kind": {
                "type": "string",
                "enum": [
                  "project",
                  "workspace",
                  "elsewhere"
                ]
              },
              "project": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 300
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "bytes": {
                "type": "number",
                "minimum": 0
              },
              "detachedBytes": {
                "type": "number",
                "minimum": 0
              },
              "detachedCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "threadCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "threads": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sessionId": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "title": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 300
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "createdAt": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "running": {
                      "type": "boolean"
                    },
                    "updatedAt": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "sessionId",
                    "title",
                    "running",
                    "updatedAt"
                  ],
                  "additionalProperties": false
                }
              },
              "trees": {
                "maxItems": 200,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "pid": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "startedAt": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 120
                    },
                    "command": {
                      "type": "string",
                      "maxLength": 400
                    },
                    "cwd": {
                      "type": "string",
                      "maxLength": 1024
                    },
                    "bytes": {
                      "type": "number",
                      "minimum": 0
                    },
                    "processCount": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "origin": {
                      "type": "string",
                      "enum": [
                        "job",
                        "host",
                        "detached"
                      ]
                    },
                    "category": {
                      "type": "string",
                      "enum": [
                        "dev-server",
                        "tests",
                        "build",
                        "dsh",
                        "services",
                        "other"
                      ]
                    },
                    "jobId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 128
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sessionId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 128
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "ownerRunning": {
                      "default": false,
                      "description": "A live job whose owning Session is mid-turn; a bulk stop leaves it to that thread’s own Stop.",
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "pid",
                    "startedAt",
                    "name",
                    "command",
                    "cwd",
                    "bytes",
                    "processCount",
                    "origin",
                    "category",
                    "jobId",
                    "sessionId",
                    "ownerRunning"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "key",
              "title",
              "path",
              "kind",
              "project",
              "bytes",
              "detachedBytes",
              "detachedCount",
              "threadCount",
              "threads",
              "trees"
            ],
            "additionalProperties": false
          }
        },
        "nodeProcesses": {
          "type": "object",
          "properties": {
            "processCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "rssBytes": {
              "type": "number",
              "minimum": 0
            },
            "truncated": {
              "type": "boolean"
            },
            "origins": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
