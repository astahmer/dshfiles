                    "type": "string",
                    "maxLength": 120
                  },
                  "source": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 120
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cwd": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 1024
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "processCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "rssBytes": {
                    "type": "number",
                    "minimum": 0
                  },
                  "samples": {
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "pid": {
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        },
                        "rssBytes": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "pid",
                        "rssBytes"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "name",
                  "source",
                  "cwd",
                  "processCount",
                  "rssBytes",
                  "samples"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "processCount",
            "rssBytes",
            "truncated",
            "origins"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "takenAt",
        "supported",
        "pressure",
        "systemBytes",
        "hostBytes",
        "trackedBytes",
        "detachedBytes",
        "detachedCount",
        "categoryBytes",
        "groups"
      ],
      "additionalProperties": false
    },
    "tool": {
      "name": "worktree_memory_snapshot",
      "readOnly": true,
      "schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  },
  "pressure": {
    "description": "The system memory-pressure level alone, read without probing process trees, plus total system memory. Read-only.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "takenAt": {
          "type": "number"
        },
        "supported": {
          "type": "boolean"
        },
        "pressure": {
          "type": "string",
          "enum": [
            "normal",
            "warning",
            "critical",
            "unknown"
          ]
        },
        "systemBytes": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "takenAt",
        "supported",
        "pressure",
        "systemBytes"
      ],
      "additionalProperties": false
    },
    "tool": {
      "name": "worktree_memory_pressure",
      "readOnly": true,
      "schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  },
  "stop": {
    "description": "Stop process trees from the snapshot on the user’s behalf: a live job through the job registry, any other tree with SIGTERM then SIGKILL. Only trees the snapshot lists can be stopped, and a recycled pid is refused. Call only when the user asked to stop them; pass confirm: true, which is required.",
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "targets": {
          "minItems": 1,
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pid": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "Root pid of a process tree from the snapshot."
              },
              "startedAt": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "The tree’s startedAt from the snapshot; a recycled pid with another start time is refused."
              }
            },
            "required": [
              "pid",
              "startedAt"
            ],
            "additionalProperties": false
          },
          "description": "Process trees from the snapshot, identified by root pid and startedAt."
        },
        "confirm": {
          "type": "boolean",
          "const": true,
          "description": "Must be true: stopping a process tree is destructive."
        }
      },
      "required": [
        "targets",
        "confirm"
      ],
      "additionalProperties": false
    },
    "output": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "stopped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "viaJob": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "missing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "refused": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "stopped",
        "viaJob",
        "missing",
        "refused"
      ],
      "additionalProperties": false
    },
    "tool": {
      "name": "worktree_memory_stop",
      "readOnly": false,
      "schema": {
        "type": "object",
        "properties": {
          "targets": {
            "description": "Process trees from the snapshot, identified by root pid and startedAt.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pid": {
                  "description": "Root pid of a process tree from the snapshot.",
                  "type": "integer"
                },
                "startedAt": {
                  "description": "The tree’s startedAt from the snapshot; a recycled pid with another start time is refused.",
                  "type": "integer"
                }
              },
              "required": [
                "pid",
                "startedAt"
              ],
              "additionalProperties": false
            }
          },
          "confirm": {
            "description": "Must be true: stopping a process tree is destructive.",
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "targets",
          "confirm"
        ],
        "additionalProperties": false
      }
    }
  }
}"
`;
