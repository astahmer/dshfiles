{
  "name": "@dshfiles/workspace-folder-picker",
  "version": "0.1.0",
  "private": true,
  "description": "Provide Host-backed folder browsing for workspace and project pickers.",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./directory-browser-api": {
      "types": "./src/directory-browser-api.ts",
      "default": "./dist/directory-browser-api.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "dshx check && pnpm lint && pnpm fmt:check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src tests dshx.config.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests",
    "build": "dshx build",
    "dev": "dshx dev --open",
    "test:boot": "node ../../../tooling/dshx/scripts/boot-check-web.mjs --plugin",
    "test:e2e": "node ../../../tooling/dshx/scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@dshfiles/plugin-ui": "workspace:*",
    "@dshfiles/project-folder-picker": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/cordis-plugin-include": "catalog:",
    "@deepseek-ai/cordis-plugin-loader": "catalog:",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "catalog:",
    "@deepseek-ai/dsh-api-remotes": "catalog:",
    "@deepseek-ai/dsh-api-workspace-controller": "catalog:",
    "@deepseek-ai/dsh-client-connection": "catalog:",
    "@deepseek-ai/dsh-client-ui-sidebar": "catalog:",
    "@deepseek-ai/dsh-client-ui-slots": "catalog:",
    "@deepseek-ai/dsh-client-ui-workspace": "catalog:",
    "@deepseek-ai/dsh-host-directory-picker": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "catalog:",
    "@dshfiles/dshx": "workspace:*",
    "@types/node": "22.20.5",
    "@types/react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-gateway": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-host-directory-picker": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-host-directory-picker-browse": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-workspace-controller"
      ],
      "external": [],
      "immediately": false
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
