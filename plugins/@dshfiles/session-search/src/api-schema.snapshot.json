{
  "id": "session-search",
  "owner": "@dshfiles/session-search",
  "version": 1,
  "methods": [
    {
      "name": "health",
      "description": "Read the owned session-search index health: indexed sessions and documents, index bytes, how many log sessions and bytes are still behind, whether an ingest pass is running, how long the last pass took, and the last error. `ownsService` is false when another plugin owns the sessionQuery service, in which case content search runs on that backend and these counters stay zero. Read-only.",
      "tool": {
        "name": "session_search_health",
        "readOnly": true
      },
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sessions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "documents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "indexBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "behindSessions": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "behindBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "ingesting": {
            "type": "boolean"
          },
          "lastIngestMs": {
            "type": "number",
            "minimum": 0
          },
          "slowestIngestMs": {
            "type": "number",
            "minimum": 0
          },
          "lastSearchMs": {
            "type": "number",
            "minimum": 0
          },
          "slowestSearchMs": {
            "type": "number",
            "minimum": 0
          },
          "lastError": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ownsService": {
            "type": "boolean"
          }
        },
        "required": [
          "sessions",
          "documents",
          "indexBytes",
          "behindSessions",
          "behindBytes",
          "ingesting",
          "lastIngestMs",
          "slowestIngestMs",
          "lastSearchMs",
          "slowestSearchMs",
          "lastError",
          "ownsService"
        ],
        "additionalProperties": false
      },
      "toolInput": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "toolOutput": {
        "type": "object",
        "properties": {
          "sessions": {
            "type": "integer"
          },
          "documents": {
            "type": "integer"
          },
          "indexBytes": {
            "type": "integer"
          },
          "behindSessions": {
            "type": "integer"
          },
          "behindBytes": {
            "type": "integer"
          },
          "ingesting": {
            "type": "boolean"
          },
          "lastIngestMs": {
            "type": "number"
          },
          "slowestIngestMs": {
            "type": "number"
          },
          "lastSearchMs": {
            "type": "number"
          },
          "slowestSearchMs": {
            "type": "number"
          },
          "lastError": {
            "type": "string"
          },
          "ownsService": {
            "type": "boolean"
          }
        },
        "required": [
          "sessions",
          "documents",
          "indexBytes",
          "behindSessions",
          "behindBytes",
          "ingesting",
          "lastIngestMs",
          "slowestIngestMs",
          "lastSearchMs",
          "slowestSearchMs",
          "lastError",
          "ownsService"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "findInThread",
      "description": "Find every event of one DSH thread (Session) whose text contains all words of `text` (the last word may be a prefix), in transcript order: the whole stored transcript, older turns and tool calls and results included (model thinking is not indexed). Each match has its event seq, type, time and a short snippet. `limit` defaults to 200; with `newest: true` the newest `limit` matches are returned (still in transcript order), which is what a find bar starting from the tail reads. `ownsService` is false when another plugin owns the sessionQuery service and this index is not built. Read-only.",
      "tool": {
        "name": "session_find_in_thread",
        "readOnly": true
      },
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "newest": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "sessionId",
          "text"
        ],
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ownsService": {
            "type": "boolean"
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seq": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "type": {
                  "type": "string"
                },
                "time": {
                  "type": "number"
                },
                "snippet": {
                  "type": "string"
                }
              },
              "required": [
                "seq",
                "type",
                "time",
                "snippet"
              ],
              "additionalProperties": false
            }
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "ownsService",
          "matches",
          "hasMore"
        ],
        "additionalProperties": false
      },
      "toolInput": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          },
          "newest": {
            "type": "boolean"
          }
        },
        "required": [
          "sessionId",
          "text"
        ],
        "additionalProperties": false
      },
      "toolOutput": {
        "type": "object",
        "properties": {
          "ownsService": {
            "type": "boolean"
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "seq": {
                  "type": "integer"
                },
                "type": {
                  "type": "string"
                },
                "time": {
                  "type": "number"
                },
                "snippet": {
                  "type": "string"
                }
              },
              "required": [
                "seq",
                "type",
                "time",
                "snippet"
              ],
              "additionalProperties": false
            }
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "ownsService",
          "matches",
          "hasMore"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "promptHistory",
      "description": "The prompts people sent across every top-level thread, newest first, each text once: only the newest `window` prompts no longer than `maxChars` characters, narrowed to those containing every word of `text` when given. Subagent threads and messages sent by a plugin or agent are left out. Read-only.",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "window": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50000
          },
          "maxChars": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          }
        },
        "required": [
          "limit",
          "window",
          "maxChars"
        ],
        "additionalProperties": false
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ownsService": {
            "type": "boolean"
          },
          "prompts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sessionId": {
                  "type": "string"
                },
                "seq": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "time": {
                  "type": "number"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "sessionId",
                "seq",
                "time",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "ownsService",
          "prompts"
        ],
        "additionalProperties": false
      }
    }
  ]
}
