{
  "schemaVersion": 1,
  "features": [
    {
      "id": "sidebar-toggle-chord",
      "title": "Toggle the sidebar with the platform primary chord",
      "summary": "Capture primary+B in the browser capture phase, prevent competing shell handling, and choose Meta on Mac or Control elsewhere.",
      "surfaces": [
        "client",
        "integration"
      ],
      "configuration": [],
      "states": [
        "matched",
        "unmatched",
        "already-handled",
        "composing",
        "repeated"
      ],
      "failureModes": [
        "Modifier mismatch leaves the browser and Host behavior untouched.",
        "A missing layout service is surfaced rather than silently swallowed."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "shortcuts.sidebar-toggle",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "gherkin",
          "id": "shortcuts.platform-primary",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "unit-test",
          "id": "shortcuts.sidebar-toggle-chord-unit-platform-primary-modifier",
          "file": "plugins/@dshfiles/shortcuts/src/keyboard.test.ts",
          "testName": "resolves primary to Meta on macOS and Control elsewhere"
        },
        {
          "kind": "unit-test",
          "id": "shortcuts.sidebar-toggle-chord-unit-extra-modifier-rejected",
          "file": "plugins/@dshfiles/shortcuts/src/keyboard.test.ts",
          "testName": "refuses a chord carrying an extra modifier"
        },
        {
          "kind": "unit-test",
          "id": "shortcuts.sidebar-toggle-chord-unit-capture-before-bubble",
          "file": "plugins/@dshfiles/shortcuts/src/keyboard.test.ts",
          "testName": "claims a matching chord before bubble listeners see it"
        },
        {
          "kind": "unit-test",
          "id": "shortcuts.sidebar-toggle-chord-unit-repeat-and-prior-claim",
          "file": "plugins/@dshfiles/shortcuts/src/keyboard.test.ts",
          "testName": "leaves events alone that someone else already handled or that repeat"
        }
      ]
    },
    {
      "id": "panel-selection-chords",
      "title": "Select native panels with keyboard shortcuts",
      "summary": "Use primary+N and primary+comma to select the declared panel target while respecting editable fields, IME composition, repeat, and prior event claims.",
      "surfaces": [
        "client",
        "integration"
      ],
      "configuration": [],
      "states": [
        "panel-selected",
        "editable-target",
        "unclaimed",
        "disposed"
      ],
      "failureModes": [
        "Extra Alt or Shift modifiers do not trigger a shortcut.",
        "Disposal unregisters the capture handler."
      ],
      "externalDependencies": [],
      "verification": [
        {
          "kind": "gherkin",
          "id": "shortcuts.panel-selection",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "gherkin",
          "id": "shortcuts.unclaimed-events",
          "featureFile": "tooling/dshx/e2e/features/plugin-journeys.feature"
        },
        {
          "kind": "unit-test",
          "id": "shortcuts.panel-selection-chords-unit-editable-target-guard",
          "file": "plugins/@dshfiles/shortcuts/src/keyboard.test.ts",
          "testName": "accepts text fields and editable regions, refuses buttons and checkboxes"
        },
        {
          "kind": "unit-test",
          "id": "shortcuts.panel-selection-chords-unit-dispose-handler",
          "file": "plugins/@dshfiles/shortcuts/src/keyboard.test.ts",
          "testName": "stops listening once disposed"
        }
      ]
    }
  ],
  "kind": "bundle"
