{
  "manifest_version": 3,
  "name": "DSH annotations",
  "version": "0.1.0",
  "description": "Annotate any page and send it to DeepSeek Harness with a loopback token.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_title": "Annotate this page for DSH",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "key": ""
}
