                "address": {
                  "type": "string"
                },
                "interfaceName": {
                  "type": "string"
                },
                "family": {
                  "type": "string",
                  "enum": ["IPv4", "IPv6"]
                }
              },
              "required": ["address", "interfaceName", "family"],
              "additionalProperties": false
            }
          },
          "cliOverrides": {
            "type": "object",
            "properties": {
              "host": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "port": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["host", "port"],
            "additionalProperties": false
