    {
      "name": "status",
      "description": "Read whether the LAN-bound DSH also has localhost access, its non-secret origins and actual loopback listeners. Read-only.",
      "tool": {
        "name": "loopback_access_status",
        "readOnly": true
      },
      "input": {
        "type": "null"
      },
      "output": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": ["starting", "native-loopback", "forwarding", "disabled", "stopped", "failed"]
          },
          "upstreamOrigin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "localhostOrigin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "listeners": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "enum": ["127.0.0.1", "::1"]
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": ["host", "port"],
              "additionalProperties": false
            }
          }
        },
        "required": ["state", "upstreamOrigin", "localhostOrigin", "listeners"],
        "additionalProperties": false
      },
      "toolInput": {
        "type": "null"
      },
      "toolOutput": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": ["starting", "native-loopback", "forwarding", "disabled", "stopped", "failed"]
          },
          "upstreamOrigin": {
            "type": "string"
          },
          "localhostOrigin": {
            "type": "string"
          },
          "listeners": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "enum": ["127.0.0.1", "::1"]
                },
                "port": {
                  "type": "integer"
                }
              },
              "required": ["host", "port"],
              "additionalProperties": false
            }
          }
        },
        "required": ["state", "upstreamOrigin", "localhostOrigin", "listeners"],
        "additionalProperties": false
      }
    }
