{
  "id": "loopback-access",
  "owner": "@dshfiles/loopback-access",
  "version": 1,
  "methods": [
    {
      "name": "network",
      "description": "Read Network access settings, concrete local address choices, actual listening URLs, CLI overrides and pending restart state. Read-only.",
      "tool": {
        "name": "network_access_settings",
        "readOnly": true
      },
      "toolInput": {},
      "toolOutput": {}
    },
    {
      "name": "saveNetwork",
      "description": "Save validated Network access choices for the next DSH startup without restarting or rebinding the running server. May run only when the user asks to change network settings; expectedRevision prevents overwriting concurrent edits.",
      "tool": {
        "name": "network_access_save",
        "readOnly": false
      },
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "lanEnabled": {
            "type": "boolean"
          },
          "bindAddress": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "localhostEnabled": {
            "default": true,
            "type": "boolean",
            "const": true
          },
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "lanEnabled",
          "bindAddress",
          "port",
          "expectedRevision"
        ],
        "additionalProperties": false
      },
      "toolInput": {
        "type": "object",
        "properties": {
          "lanEnabled": {
            "type": "boolean"
          },
          "bindAddress": {
            "type": "string"
          },
          "localhostEnabled": {
            "type": "boolean",
            "const": true
          },
          "port": {
            "type": "integer"
          },
          "expectedRevision": {
            "type": "integer"
          }
        },
        "required": [
          "lanEnabled",
          "bindAddress",
          "port",
          "expectedRevision"
        ],
        "additionalProperties": false
      },
      "toolOutput": {}
    },
    {
      "name": "status",
      "description": "Read whether the LAN-bound DSH also has localhost access, its non-secret origins and actual loopback listeners. Read-only.",
      "tool": {
        "name": "loopback_access_status",
        "readOnly": true
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "starting",
              "native-loopback",
              "forwarding",
              "disabled",
              "stopped",
              "failed"
            ]
          },
          "upstreamOrigin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "localhostOrigin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "listeners": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "enum": [
                    "127.0.0.1",
                    "::1"
                  ]
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "host",
                "port"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "state",
          "upstreamOrigin",
          "localhostOrigin",
          "listeners"
        ],
        "additionalProperties": false
      },
      "toolInput": {},
      "toolOutput": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "starting",
              "native-loopback",
              "forwarding",
              "disabled",
              "stopped",
              "failed"
            ]
          },
          "upstreamOrigin": {
            "type": "string"
          },
          "localhostOrigin": {
            "type": "string"
          },
          "listeners": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "enum": [
                    "127.0.0.1",
                    "::1"
                  ]
                },
                "port": {
                  "type": "integer"
                }
              },
              "required": [
                "host",
                "port"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "state",
          "upstreamOrigin",
          "localhostOrigin",
          "listeners"
        ],
        "additionalProperties": false
      }
    }
  ]
}