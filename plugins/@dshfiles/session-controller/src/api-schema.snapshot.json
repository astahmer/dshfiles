{
  "apis": [
    {
      "id": "session-continuation",
      "owner": "@dshfiles/session-controller",
      "version": 1,
      "methods": [
        {
          "name": "continueIn",
          "description": "Fork one thread into the registered project (DSH Workspace) given by workspaceId: the new thread runs in that directory and is accounted to it. includeOpenTurn cuts after the newest event instead of at the latest completed turn.",
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "workspaceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "includeOpenTurn": {
                "type": "boolean"
              }
            },
            "required": [
              "sessionId",
              "workspaceId",
              "includeOpenTurn"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string"
              }
            },
            "required": [
              "sessionId"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "id": "chat-resume",
      "owner": "@dshfiles/session-controller",
      "version": 1,
      "methods": [
        {
          "name": "available",
          "description": "Check whether this exact stopped task is still latest and idle, and whether it is resumed (it had started answering) or retried (it produced nothing).",
          "tool": {
            "name": "chat_stopped_turn_status",
            "readOnly": true
          },
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "sessionId",
              "seq"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "available": {
                "type": "boolean"
              },
              "action": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "resume",
                      "retry"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "available"
            ],
            "additionalProperties": false
          },
          "toolInput": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "seq": {
                "type": "integer"
              }
            },
            "required": [
              "sessionId",
              "seq"
            ],
            "additionalProperties": false
          },
          "toolOutput": {
            "type": "object",
            "properties": {
              "available": {
                "type": "boolean"
              },
              "action": {
                "type": "string",
                "enum": [
                  "resume",
                  "retry"
                ]
              }
            },
            "required": [
              "available"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "resume",
          "description": "Resume this exact interrupted task only when the user asks; refuses superseded or busy tasks.",
          "tool": {
            "name": "chat_resume_interrupted"
          },
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "sessionId",
              "seq"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "accepted": {
                "type": "boolean"
              }
            },
            "required": [
              "accepted"
            ],
            "additionalProperties": false
          },
          "toolInput": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "seq": {
                "type": "integer"
              }
            },
            "required": [
              "sessionId",
              "seq"
            ],
            "additionalProperties": false
          },
          "toolOutput": {
            "type": "object",
            "properties": {
              "accepted": {
                "type": "boolean"
              }
            },
            "required": [
              "accepted"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "retry",
          "description": "Run this exact stopped task again when it produced no reply (such as a sign-in or quota failure on its request) without adding a prompt; only when the user asks. Refuses superseded, busy or partly answered tasks.",
          "tool": {
            "name": "chat_retry_failed_turn"
          },
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "sessionId",
              "seq"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "accepted": {
                "type": "boolean"
              }
            },
            "required": [
              "accepted"
            ],
            "additionalProperties": false
          },
          "toolInput": {
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "seq": {
                "type": "integer"
              }
            },
            "required": [
              "sessionId",
              "seq"
            ],
            "additionalProperties": false
          },
          "toolOutput": {
            "type": "object",
            "properties": {
              "accepted": {
                "type": "boolean"
              }
            },
            "required": [
              "accepted"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    {
      "id": "sessions",
      "owner": "@dshfiles/session-controller",
      "version": 1,
      "methods": [
        {
          "name": "list",
          "description": "List visible threads newest first, with title, directory, project and whether a turn is running. query matches title, directory or project title.",
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "query": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "projectId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "includeArchived": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "limit": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "threads": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sessionId": {
                      "type": "string"
                    },
                    "title": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "cwd": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "projectId": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "projectTitle": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "running": {
                      "type": "boolean"
                    },
                    "updatedAt": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "string",
                          "enum": [
                            "Infinity",
                            "-Infinity",
                            "NaN"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "sessionId",
                    "running",
                    "updatedAt"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 200
              },
              "total": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "threads",
              "total",
              "truncated"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "messages",
          "description": "A thread's most recent user and assistant messages, oldest first, each clipped to 8,000 characters.",
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "limit": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "sessionId"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "running": {
                "type": "boolean"
              },
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "seq": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "user",
                        "assistant"
                      ]
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "seq",
                    "role",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 100
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "sessionId",
              "running",
              "entries",
              "truncated"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "create",
          "description": "Start a thread in a project (projectId) or a directory (cwd), optionally with an agent preset, a title, a model and a first prompt.",
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "projectId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cwd": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "agentPreset": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "title": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "model": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "model": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 400
                      },
                      "reasoningEffort": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "provider",
                      "model"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "prompt": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string"
              }
            },
            "required": [
              "sessionId"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "prompt",
          "description": "Send a user prompt: queue it for the next turn, or steer the running turn.",
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "text": {
                "type": "string"
              },
              "mode": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "queue",
                      "steer"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "sessionId",
              "text"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "accepted": {
                "type": "boolean",
                "enum": [
                  true
                ]
              }
            },
            "required": [
              "accepted"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "command",
          "description": "Run a slash command line in a thread, as typed in its composer (e.g. \"/compact\").",
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "line": {
                "type": "string"
              }
            },
            "required": [
              "sessionId",
              "line"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "success",
                  "error"
                ]
              },
              "text": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "message",
          "description": "Add a message to the thread on behalf of a plugin: it reaches the model like a user message but is recorded with the plugin as its source. next-turn waits for the next turn, next-step joins the running one; wake starts a turn on an idle thread.",
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "text": {
                "type": "string"
              },
              "target": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "next-turn",
                      "next-step"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "wake": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "sessionId",
              "text"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "messageId": {
                "type": "string"
              }
            },
            "required": [
              "messageId"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "compact",
          "description": "Compact the thread's history now (the /compact command).",
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "sessionId"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "success",
                  "error"
                ]
              },
              "text": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "interrupt",
          "description": "Stop the running turn; queued prompts stay queued.",
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "sessionId"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "interrupted": {
                "type": "boolean",
                "enum": [
                  true
                ]
              }
            },
            "required": [
              "interrupted"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "wait",
          "description": "Wait until the thread is idle with nothing queued, or until timeoutMs passes.",
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "timeoutMs": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 600000
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "sessionId"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "idle",
                  "running"
                ]
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "selectModel",
          "description": "Switch the thread's model; the next request uses it.",
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "reasoningEffort": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "sessionId",
              "provider",
              "model"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "reasoningEffort": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "provider",
              "model"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "selectAgent",
          "description": "Switch the agent preset the thread runs.",
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "agentPreset": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "sessionId",
              "agentPreset"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "agentPreset": {
                "type": "string"
              }
            },
            "required": [
              "agentPreset"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "instructions",
          "description": "The keyed instructions added to this thread’s prompt.",
          "input": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "sessionId"
            ],
            "additionalProperties": false
          },
          "output": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "key",
                    "text"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "entries"
            ],
            "additionalProperties": false
          }
        },
        {
          "name": "setInstruction",
          "description": "Add, replace (same key) or remove (text null) one instruction that every later request of this thread carries in its prompt; kept across Host restarts.",
