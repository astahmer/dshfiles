{
  "name": "@dshfiles/session-persistence-jsonl",
  "version": "0.1.0",
  "private": true,
  "description": "Owned fork of DSH's JSONL session-persistence backend that stores a Session's request-header tool catalog once instead of once per request series.",
  "license": "MIT",
  "files": [
    "dist",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "dshx build && node scripts/build-worker.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "koffi": "3.1.1",
    "p-limit": "7.3.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "catalog:",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "catalog:",
    "@deepseek-ai/dsh-session": "catalog:",
    "@deepseek-ai/dsh-session-format": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-format-catalog": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@deepseek-ai/node-addon-system": "0.1.2",
    "@deepseek-ai/schemastery": "catalog:",
    "@dshfiles/dshx": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-format": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-format-catalog": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-format-v3-to-v4": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/node-addon-system": "~0.1.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshx": {
    "features": "./dshx.features.json"
  }
}
