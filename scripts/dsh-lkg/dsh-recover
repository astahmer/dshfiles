#!/bin/sh
# dsh-recover — start the last known good DSH.
#
# Self-contained on purpose: it runs only what the snapshot store holds, never
# the repository, the pnpm global install, or the live ~/.dsh profile. That is
# what makes it work after an agent breaks the main installation. Live data is
# cloned in read-only so accounts and threads are there too.
#
#   DSH_LKG_ROOT   store location        (default ~/.dsh-lkg)
#   DSH_LKG_PORT   listen port           (default 3099)
#   DSH_LKG_HOME   writable runtime home (default <store>/state/recover)
#   DSH_LKG_LIVE_HOME  live data to clone  (default ~/.dsh)
#   DSH_LKG_CLEAN  1 starts with no live data
set -eu

ROOT="${DSH_LKG_ROOT:-$HOME/.dsh-lkg}"
PORT="${DSH_LKG_PORT:-3099}"
LINK="$ROOT/current"

if [ ! -L "$LINK" ]; then
  echo "dsh-recover: no last known good snapshot at $LINK" >&2
  echo "dsh-recover: create one with: node ~/dev/dshfiles/scripts/dsh-lkg/cli.mjs snapshot" >&2
  exit 1
fi

VERSION="$(readlink "$LINK")"
case "$VERSION" in
  /*) ;;
  *) VERSION="$ROOT/$VERSION" ;;
esac
if [ ! -d "$VERSION" ]; then
  echo "dsh-recover: snapshot $VERSION is missing; the store is inconsistent" >&2
  exit 1
fi

NODE="$(cat "$VERSION/runtime/node-path" 2>/dev/null || true)"
if [ ! -x "$NODE" ]; then
  NODE="$(command -v node || true)"
fi
if [ -z "$NODE" ]; then
  echo "dsh-recover: no node runtime available (recorded path is gone and node is not on PATH)" >&2
  exit 1
fi

ENTRY="$VERSION/runtime/node_modules/@deepseek-ai/dsh/lib/bin.js"
if [ ! -f "$ENTRY" ]; then
  echo "dsh-recover: snapshot is incomplete, missing $ENTRY" >&2
  exit 1
fi

HOME_DIR="${DSH_LKG_HOME:-$ROOT/state/recover}"
LIVE_HOME="${DSH_LKG_LIVE_HOME:-$HOME/.dsh}"

# Every start rebuilds the state from the newest data: an APFS clone of the live
# DSH_HOME (accounts, credentials, plugin storage, threads) minus the parts the
# snapshot owns or that are disposable, plus the snapshot's own profile. The live
# home is only read. The previous recovery state is kept once as <state>.prev, so
# work done during a recovery survives the next start.
rm -rf "$HOME_DIR.prev"
if [ -d "$HOME_DIR" ]; then
  chflags -R nouchg "$HOME_DIR" 2>/dev/null || true
  mv "$HOME_DIR" "$HOME_DIR.prev"
fi
mkdir -p "$HOME_DIR/profiles"
if [ "${DSH_LKG_CLEAN:-0}" != 1 ] && [ -d "$LIVE_HOME" ]; then
  echo "dsh-recover: cloning live data from $LIVE_HOME (read only)"
  for entry in "$LIVE_HOME"/* "$LIVE_HOME"/.[!.]*; do
    [ -e "$entry" ] || continue
    case "$(basename "$entry")" in
      profiles | logs | cache | runtime | jj-isolation) continue ;;
    esac
    cp -c -R "$entry" "$HOME_DIR/" 2>/dev/null || cp -R "$entry" "$HOME_DIR/"
  done
  find "$HOME_DIR/sessions" -name session.lock -delete 2>/dev/null || true
fi
# On macOS the snapshot is frozen on purpose (uchg); the state this instance runs
# from must be writable, or the Host cannot maintain its own profile. `cp -R`
# carries uchg over and then fails to set times on the locked copies, so copy
# without flags through the system bsdtar: a dev shell may put GNU tar first, and
# GNU tar has no --no-fflags. Linux has no uchg, so a plain copy is enough there.
mkdir "$HOME_DIR/profiles/web"
if [ "$(uname -s)" = Darwin ]; then
  /usr/bin/tar -cf - -C "$VERSION/profile" . | /usr/bin/tar -xf - --no-fflags -C "$HOME_DIR/profiles/web"
else
  cp -R "$VERSION/profile/." "$HOME_DIR/profiles/web"
fi

echo "dsh-recover: last known good $(basename "$VERSION")"
echo "dsh-recover: state $HOME_DIR (DSH_LKG_CLEAN=1 starts without live data)"
echo "dsh-recover: changes made here stay here; the live installation is untouched"

# Live data can be newer than the snapshot: a plugin store migrated after it was taken refuses to open
# (SqliteStoreVersionUnsupported) and fails the whole Host. Recovery must still boot, so such a store is set
# aside in the recovery clone only (that plugin starts empty here) and the Host starts again.
mkdir -p "$HOME_DIR/logs"
HOST_LOG="$HOME_DIR/logs/recover-host.log"
attempt=0
while :; do
  attempt=$((attempt + 1))
  rm -f "$HOST_LOG.status"
  { env DSH_HOME="$HOME_DIR" DSH_LKG_RECOVER=1 "$NODE" "$ENTRY" web --port "$PORT" "$@" 2>&1; echo $? >"$HOST_LOG.status"; } | tee "$HOST_LOG"
  status="$(cat "$HOST_LOG.status" 2>/dev/null || echo 1)"
  newer="$(awk -v home="$HOME_DIR/" -v q="'" '
    /SqliteStoreVersionUnsupported/ { pending = 1; next }
    pending && /filename:/ {
      start = index($0, q)
      rest = substr($0, start + 1)
      path = substr(rest, 1, index(rest, q) - 1)
      if (start > 0 && index(path, home) == 1) print path
      pending = 0
    }
  ' "$HOST_LOG" | sort -u)"
  if [ -z "$newer" ] || [ "$attempt" -ge 5 ]; then
    exit "$status"
  fi
  printf '%s\n' "$newer" | while IFS= read -r store; do
    echo "dsh-recover: $store was written by a newer DSH than this snapshot; that plugin starts empty here (kept as $store.newer-than-lkg)"
    for file in "$store" "$store-wal" "$store-shm"; do
      if [ -e "$file" ]; then mv -f "$file" "$file.newer-than-lkg"; fi
    done
  done
done
