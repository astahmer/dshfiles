+  runtimePlugins: [
+    {
+      id: 'cordis-host-runner',
+      packageName: '@deepseek-ai/dsh-cordis-host-runner',
+      load: 'default',
+      provides: ['cordisInspect'],
+      optional: true,
+    },
+    {
+      id: 'tool-cordis',
+      packageName: '@deepseek-ai/dsh-tool-cordis',
+      load: 'module',
+      provides: ['Service', 'Event'],
+      optional: true,
