+import { describe, expect, expectTypeOf, it } from 'vitest'
+import { createTestClient, createTestHost, mountPlugin } from '../src/testing/index.js'
+import { definePlugin, defineTool } from '../src/host/index.js'
+import { defineClientPlugin } from '../src/client/index.js'
+import type { Context } from '@deepseek-ai/cordis'
+import type { PropsRenderSlots } from '@deepseek-ai/dsh-client-ui-slots'
+
+describe('native SDK testing utilities', () => {
+  it('mounts native Host capabilities and removes tools and commands', async () => {
+    const host = await createTestHost()
+    try {
+      const plugin = await mountPlugin(
+        host,
+        definePlugin({
+          id: 'example',
+          uses: ['commands', 'tools'],
+          setup(api) {
+            api.commands.register({
+              name: 'example',
+              description: 'Example',
+              handler: () => ({ kind: 'success' }),
+            })
+            api.tools.register(
+              defineTool({
+                name: 'example_tool',
+                description: 'Example',
+                parameters: {},
+                output: {
+                  schema: { type: 'string' },
+                  render: (_args, value) => [{ type: 'text', text: value }],
+                },
+                execute: async () => 'Hello',
+              }),
+            )
+          },
+        }),
+      )
+      expect(host.commands.get('example')).toBeDefined()
+      expect(host.tools.get('example_tool')).toBeDefined()
+      await plugin.dispose()
+      expect(host.commands.get('example')).toBeUndefined()
+      expect(host.tools.get('example_tool')).toBeUndefined()
+    } finally {
+      await host.dispose()
+    }
+  })
+
+  it('uses the native slot registry through declaration loss, recreation, reload and unload', async () => {
+    const client = await createTestClient()
+    const declare = () =>
+      client.slots.register(
+        {
+          name: 'root',
+          children: {
+            main: { kind: 'keyed', scope: 'root' },
+            'sidebar.panellist': { kind: 'list', scope: 'root' },
+          },
+        },
+        (props: PropsRenderSlots<'main' | 'sidebar.panellist'>) => {
+          void props.renderSlot
+          return null
+        },
+      )
+    let rootDispose = declare()
+    try {
+      let raw: Context | undefined
+      const definition = defineClientPlugin({
+        id: 'example',
+        uses: ['ui'],
+        setup(api) {
+          raw = api.raw.ctx
+          api.ui.register({ name: 'main', key: 'example' }, () => null)
+          api.ui.register(
+            {
+              name: 'sidebar.panellist',
+              id: 'example',
+              order: 100,
+              label: 'Example',
+            },
+            props => {
+              expectTypeOf(props.size).toEqualTypeOf<number>()
+              expectTypeOf(props.active).toEqualTypeOf<boolean>()
+              return null
+            },
+          )
+        },
+      })
+      const plugin = await client.mount(definition)
+      expect(raw).toBe(plugin.ctx)
+      expect(client.slots.entries('main')).toHaveLength(1)
+      rootDispose()
+      expect(client.slots.entries('main')).toHaveLength(0)
+      rootDispose = declare()
+      expect(client.slots.entries('main')).toHaveLength(1)
+      await plugin.reload()
+      expect(client.slots.entries('main')).toHaveLength(1)
+      await plugin.dispose()
+      expect(client.slots.entries('main')).toHaveLength(0)
+      expect(client.slots.entries('sidebar.panellist')).toHaveLength(0)
+    } finally {
+      rootDispose()
+      await client.dispose()
+    }
+  })
+})
diff --git a/packages/dshx/tests/sdk-host.spec.ts b/packages/dshx/tests/sdk-host.spec.ts
new file mode 100644
index 0000000000..096a53dbaf
--- /dev/null
+++ b/packages/dshx/tests/sdk-host.spec.ts
@@ -0,0 +1,91 @@
+import { Context } from '@deepseek-ai/cordis'
+import { CommandRuntime } from '@deepseek-ai/dsh-commands'
+type Agent = Parameters<CommandRuntime['find']>[0]
+import { describe, expect, expectTypeOf, it, vi } from 'vitest'
+import { definePlugin, type PluginApi } from '../src/host/index.js'
+import { createHostPlugin } from '../src/host/runtime.js'
+
+declare module '@deepseek-ai/cordis' {
+  interface Events {
+    'sdk/test': (value: number) => void
+  }
+}
+
+describe('native SDK Host', () => {
+  it('uses native commands, scoped context, events, and cleanup through reload and unload', async () => {
+    const root = new Context()
+    const provider = root.plugin(CommandRuntime)
+    await provider
+    const listener = vi.fn()
+    const cleanup = vi.fn()
+    let api: PluginApi<readonly ['commands']> | undefined
+    const definition = definePlugin({
+      id: 'example',
+      uses: ['commands'],
+      setup(value) {
+        api = value
+        value.commands.register({
+          name: 'hello',
+          description: 'Hello',
+          handler: () => ({ kind: 'success', text: 'Hello' }),
+        })
+        value.events.on('sdk/test', listener)
+        value.lifecycle.onDispose(cleanup)
+      },
+    })
+    const plugin = createHostPlugin(definition, { packageId: '@test/example' })
+    expect(plugin.inject).toEqual(['commands'])
+    const fiber = root.plugin(plugin)
+    await fiber
+    const agent = { ctx: root } as Agent
+    expect(api?.raw.ctx).toBe(fiber.ctx)
+    expect(root.commands.find(agent, 'hello')).toBeDefined()
+    root.emit('sdk/test', 42)
+    expect(listener).toHaveBeenCalledWith(42)
+    await fiber.restart()
+    expect(cleanup).toHaveBeenCalledTimes(1)
+    expect(root.commands.find(agent, 'hello')).toBeDefined()
+    await fiber.dispose()
+    expect(root.commands.find(agent, 'hello')).toBeUndefined()
+    root.emit('sdk/test', 99)
+    expect(listener).toHaveBeenCalledTimes(1)
+    expect(cleanup).toHaveBeenCalledTimes(2)
+    await fiber.dispose()
+    expect(cleanup).toHaveBeenCalledTimes(2)
+    expect(() =>
+      api?.commands.register({
+        name: 'late',
+        description: 'Late',
+        handler: () => ({ kind: 'success' }),
+      }),
+    ).toThrow('inactive context')
+    await provider.dispose()
+  })
+
+  it('only exposes declared capabilities and preserves native inference', () => {
+    const definition = definePlugin({
+      id: 'typed',
+      uses: ['commands'],
+      setup(api) {
+        expectTypeOf(api.raw.ctx).toEqualTypeOf<Context>()
+        api.commands.register({
+          name: 'test',
+          description: 'Test',
+          handler(invocation) {
+            expectTypeOf(invocation.rawInput).toEqualTypeOf<string>()
+            return { kind: 'success' }
+          },
+        })
+        api.events.on('sdk/test', value => {
+          expectTypeOf(value).toEqualTypeOf<number>()
+        })
+        // @ts-expect-error Tools require uses: ['tools'].
+        void api.tools
+        // @ts-expect-error Unknown events are rejected.
+        api.events.on('sdk/unknown', () => {})
+      },
+    })
+    expect(definition.inject).toEqual(['commands'])
+    expect(() => definePlugin({ id: 'Invalid_ID' })).toThrow('Plugin id')
+  })
+})
