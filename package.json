{
  "name": "dshfiles",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "pnpm install --frozen-lockfile && pnpm run setup:browser",
    "setup:browser": "pnpm --dir tooling/dshx exec playwright install --only-shell chromium",
    "check:dshx": "pnpm --dir tooling/dshx run check && pnpm --dir tooling/dshx run deps:check",
    "check:plugins": "pnpm --dir plugins run check",
    "check": "pnpm run check:green && pnpm run lint && pnpm run fmt:check",
    "check:green": "pnpm run typecheck:scripts && pnpm run check:cycles && pnpm run test:scripts && pnpm run verify:web-profile-contract && pnpm run check:dshx && pnpm run check:screenshots && pnpm run check:plugins && pnpm run knip && pnpm run check:plugin-boot && pnpm run check:e2e:smoke",
    "check:cycles": "node scripts/workspace-cycles.mjs",
    "check:diff": "node scripts/check-diff.mjs",
    "jj:state": "node scripts/jj-state.mjs",
    "knip": "pnpm --dir tooling/dshx exec knip --directory ../.. --config \"$PWD/knip.jsonc\" --no-config-hints",
    "lint": "node scripts/lint-ratchet.ts oxlint && node scripts/lint-ratchet.ts ast-grep",
    "sg": "ast-grep scan tooling/dshx/packages plugins scripts --globs=!plugins/@dshfiles/model-selection/src/native/** --globs=!plugins/@dshfiles/agent-preset/src/native/** --globs=!plugins/@dshfiles/rich-composer/src/native/** --globs=!plugins/@dshfiles/chat/src/native/** --globs=!plugins/@dshfiles/user-questions/src/native/** --globs=!plugins/@dshfiles/session-controller/src/native/** --globs=!plugins/@dshfiles/subprocess-local/src/native/** --globs=!plugins/@dshfiles/session-controller/src/host.ts --globs=!plugins/@dshfiles/subprocess-local/src/host.ts --globs=!plugins/@dshfiles/session-controller/typert/** --globs=!plugins/@dshfiles/frame-layout/src/native/** --globs=!plugins/@dshfiles/workspace-nav/src/native/** --globs=!plugins/@dshfiles/workspace-nav/src/host.ts",
    "fmt": "oxfmt tooling/dshx/packages plugins scripts --config .oxfmtrc.json",
    "fmt:check": "oxfmt --check tooling/dshx/packages plugins scripts --config .oxfmtrc.json",
    "check:plugin-boot": "node scripts/check-browser.mjs boot",
    "check:e2e": "node scripts/check-browser.mjs e2e",
    "check:e2e:smoke": "node scripts/check-browser.mjs smoke",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "profile:sync": "node scripts/profile-sync.ts",
    "profile:boot": "node scripts/profile-boot.ts",
    "test:web-profile-contract": "node --test scripts/verify-web-profile-contract.test.mjs",
    "verify:web-profile-contract": "node scripts/verify-web-profile-contract.mjs",
    "build": "node scripts/turbo.mjs run build --filter=!dshfiles-plugins --filter=!dshx-workspace",
    "typecheck": "node scripts/turbo.mjs run typecheck typecheck:scripts --filter=!dshfiles-plugins --filter=!dshx-workspace",
    "test": "node scripts/turbo.mjs run test test:scripts test:tooling --filter=!dshfiles-plugins --filter=!dshx-workspace",
    "test:selection": "node --test scripts/test-selection.test.mjs",
    "bench:selection": "node scripts/test-selection-bench.mjs",
    "test:changed": "node scripts/test-selection.mjs changed",
    "test:related": "node scripts/test-selection.mjs related",
    "test:tooling": "pnpm --dir tooling/dshx run test:browser-cache && pnpm --dir tooling/dshx run test:evidence && pnpm --dir tooling/dshx run test:inventory && pnpm --dir tooling/dshx run test:feature-coverage && pnpm --dir tooling/dshx run test:browser-tasks",
    "test:scripts": "node --test scripts/*.test.mjs scripts/dsh-lkg/*.test.mjs",
    "screenshots": "node scripts/plugin-screenshots.mjs",
    "check:screenshots": "node scripts/plugin-screenshots.mjs --check"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.45.3",
    "@types/node": "22.20.5",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "2.11.8",
    "typescript": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@12.5.1"
}
