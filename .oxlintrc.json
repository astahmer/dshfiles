{
  "plugins": ["typescript", "oxc", "react"],
  "jsPlugins": [
    {
      "name": "antislop",
      "specifier": "./tooling/antislop/index.mjs"
    },
    {
      "name": "ui-guidance",
      "specifier": "./tooling/antislop/repo-rules/no-native-title.mjs"
    },
    {
      "name": "effect-antislop",
      "specifier": "./tooling/antislop/effect/oxlint/index.mjs"
    },
    {
      "name": "effect-migration",
      "specifier": "./tooling/antislop/effect/repo-rules/index.mjs"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/immutability": "off",
    "react/incompatible-library": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/no-deriving-state-in-effects": "off",
    "react/preserve-manual-memoization": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/exhaustive-deps": "warn",
    "react/purity": "warn",
    "antislop/no-chained-type-assertions": "error",
    "antislop/no-broad-object-parameters": "error",
    "antislop/no-conditional-empty-object-spread": "warn",
    "antislop/no-known-value-widening": "warn",
    "antislop/no-export-bag": [
      "error",
      {
        "minExports": 3,
        "excludePaths": [
          "plugins/@dshfiles/plugin-ui/src/components/ui/**",
          "tooling/dshx/packages/**/src/**/index.ts",
          "tooling/dshx/packages/dshx/src/effect/plugin.ts",
          "plugins/@dshfiles/workbench/src/registry.ts",
          "tooling/dshx/scripts/**",
          "tooling/dshx/e2e/support/**",
          "**/test/**",
          "**/tests/**",
          "**/testing/**"
        ]
      }
    ],
    "effect-antislop/no-catch-if-tagged-error": "error",
    "effect-antislop/no-silent-error-swallow": "error",
    "effect-antislop/no-sequential-effect-yield-in-loop": [
      "error",
      {
        "domainPaths": ["plugins/@dshfiles/*/src/", "tooling/dshx/packages/dshx/src/"],
        "excludePaths": [".test.", ".spec.", ".bench.", "/fixtures/", "/e2e/"]
      }
    ],
    "effect-antislop/no-service-flat-map-facade": "error",
    "effect-antislop/no-untyped-readable-stream-error": "error",
    "effect-migration/no-effect-unstable-import": "error",
    "effect-migration/no-effect-api-promise-lift": "error",
    "effect-migration/no-try-catch-around-effect": "error",
    "effect-migration/require-curried-tagged-error": "error",
    "effect-migration/no-raw-error-in-effect": "error",
    "effect-migration/no-unscoped-plugin-timer": "error",
    "effect-migration/no-run-promise-in-host-handler": "error",
    "effect-migration/no-cordis-get-outside-root-layer": "error",
    "antislop/no-reflect-apply": "error",
    "antislop/no-reflect-get": "error",
    "antislop/no-passthrough-variable": "error",
    "antislop/no-runtime-typeof": [
      "warn",
      {
        "allowInTypeGuards": true,
        "allowWhenStaticallyTyped": true,
        "allowInBoundaryFunctions": true
      }
    ],
    "antislop/no-unsafe-dictionary-type": "warn",
    "antislop/no-unknown-parameters": "warn",
    "antislop/no-unknown-returns": "warn",
    "antislop/no-unknown-type-aliases": "warn",
    "antislop/no-widen-then-assert": "warn",
    "antislop/require-safety-comment-for-type-assertion": "warn",
    "ui-guidance/no-native-title": [
      "warn",
      {
        "allowComponents": ["AlertDialog", "ChartFrame", "Dialog", "DisclosureRow", "Modal", "OnboardingModal", "Panel", "Section", "TitleField"]
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "tooling/antislop/index.mjs",
    "output/**",
    "plugins/@dshfiles/model-selection/src/native/**",
    "plugins/@dshfiles/agent-preset/src/native/**",
    "plugins/@dshfiles/frame-layout/src/native/**",
    "plugins/@dshfiles/user-questions/src/native/**",
    "plugins/@dshfiles/rich-composer/src/native/**",
    "plugins/@dshfiles/chat/src/native/**",
    "plugins/@dshfiles/session-controller/src/native/**",
    "plugins/@dshfiles/subprocess-local/src/native/**",
    "plugins/@dshfiles/goal-tool/src/native/**",
    "plugins/@dshfiles/tool-ask-user/src/native/**",
    "plugins/@dshfiles/session-controller/src/host.ts",
    "plugins/@dshfiles/subprocess-local/src/host.ts",
    "plugins/@dshfiles/session-controller/typert/**",
    "plugins/@dshfiles/workspace-nav/src/native/**",
    "plugins/@dshfiles/workspace-nav/src/host.ts",
    "plugins/@dshfiles/rich-composer/src/submission-settings.ts",
    "plugins/@dshfiles/chat/src/chat-settings.ts",
    "plugins/@dshfiles/chat/src/host.ts",
    "plugins/@dshfiles/chat/src/css-modules.d.ts",
    "plugins/@dshfiles/settings-models/src/native/**",
    "plugins/@dshfiles/settings-models/src/host.ts",
    "plugins/@dshfiles/settings-models/src/onboarding-*.ts",
    "plugins/@dshfiles/settings-models/src/css-modules.d.ts"
  ],
  "overrides": [
    {
      "files": ["tooling/dshx/packages/dshx/src/client/env.ts", "tooling/dshx/packages/dshx/client/env.d.ts", "tooling/dshx/packages/dshx/client/index.d.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    }
  ]
}
