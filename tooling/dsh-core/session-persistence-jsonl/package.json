{
  "name": "@deepseek-ai/dsh-session-persistence-jsonl",
  "description": "JSONL durable session persistence backend for the DeepSeek Harness",
  "version": "0.2.0-rc.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-persistence-jsonl"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-catalog": "link:../session-format-catalog",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.0-rc.2",
    "@deepseek-ai/node-addon-system": "0.1.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "koffi": "3.1.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-session": "link:../session",
    "@deepseek-ai/dsh-session-format-v0-to-v1": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-v1-to-v2": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "link:../session-persistence",
    "@types/node": "22.20.5",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
