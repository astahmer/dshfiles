{
  "name": "@deepseek-ai/dsh-session-format-v4-to-v5",
  "version": "0.2.0-rc.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-format": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "link:../session",
    "@types/node": "22.20.5",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "dsh": {
    "sessionFormatMigration": {
      "from": 4,
      "to": 5,
      "export": ".",
      "migration": "sessionFormatV4ToV5",
      "sourceCodec": "releasedV4SessionFormatCodec",
      "targetCodec": "releasedV5SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV5Header",
      "targetRestorer": "restoreReleasedV5Artifact"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
