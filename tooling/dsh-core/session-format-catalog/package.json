{
  "name": "@deepseek-ai/dsh-session-format-catalog",
  "description": "Build-static first-party Session format codec and migration catalog",
  "version": "0.2.0-rc.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-format-catalog"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./message-projections": {
      "types": "./lib/types/message-projections.d.ts",
      "default": "./lib/types/message-projections.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-session-format": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-v0-to-v1": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-v1-to-v2": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-v2-to-v3": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-image-offload": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-format-v4-to-v5": "link:../session-format-v4-to-v5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "link:../session",
    "@types/node": "22.20.5",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}
