{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "include": [
    "files",
    "dependencies",
    "unlisted",
    "binaries",
    "unresolved",
    "catalog",
    "catalogReferences",
  ],
  "ignoreBinaries": ["dsh", "dshx", "jj"],
  "ignore": ["scripts/smoke-multi-host*.mjs"],
  "workspaces": {
    ".": {
      "entry": [
        "e2e/support/steps.ts",
        "e2e/support/plugin-journeys/**/*.ts",
        "scripts/smoke-client-slot.mjs",
        "scripts/smoke-multi-host.mjs",
        "scripts/smoke-multi-host-ssh.mjs"
      ],
    },
    "packages/dshx": {
      "entry": [
        "src/index.ts",
        "src/config/index.ts",
        "src/host/index.ts",
        "src/client/index.ts",
        "src/client/env.ts",
        "src/api/index.ts",
        "src/settings/index.ts",
        "src/conversation/index.ts",
        "src/tooling/index.ts",
        "src/platform/index.ts",
        "src/communication/index.ts",
        "src/testing/index.ts",
        "src/cli/bin.ts",
        "src/cli/index.ts",
        "src/compiler/host/index.ts",
        "scripts-mh-workspace-probe.mjs",
      ],
      "ignoreDependencies": ["@deepseek-ai/dsh"],
    },
  },
}
