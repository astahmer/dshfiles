{
  "name": "@dshfiles/dshx",
  "version": "0.1.4-preview.3",
  "private": true,
  "description": "Build and debug typed DeepSeek Harness Host and Client plugins with TypeScript and Vite.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "plugins",
    "typescript",
    "vite",
    "developer-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "homepage": "./README.md",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dshx": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "default": "./dist/settings/index.js"
    },
    "./experimental/conversation": {
      "types": "./dist/conversation/index.d.ts",
      "default": "./dist/conversation/index.js"
    },
    "./tooling": {
      "types": "./dist/tooling/index.d.ts",
      "default": "./dist/tooling/index.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "default": "./dist/platform/index.js"
    },
    "./communication": {
      "types": "./dist/communication/index.d.ts",
      "default": "./dist/communication/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-ambient.mjs",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@standard-schema/spec": "^1.1.0",
    "citty": "0.2.2",
    "diff": "9.0.0",
    "execa": "catalog:",
    "semver": "7.8.5",
    "zod": "^4.6.5",
    "ws": "^8.18.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "write-file-atomic": "7.0.0",
    "yaml": "catalog:",
    "create-dshx": "workspace:*",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@types/ws": "^8.5.13"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
