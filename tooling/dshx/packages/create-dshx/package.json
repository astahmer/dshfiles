{
  "name": "create-dshx",
  "version": "0.1.4-preview.3",
  "private": true,
  "description": "Create a DeepSeek Harness plugin project.",
  "keywords": [
    "cli",
    "deepseek",
    "deepseek-harness",
    "plugins",
    "scaffold",
    "typescript"
  ],
  "homepage": "./README.md",
  "license": "MIT",
  "bin": {
    "create-dshx": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities.d.ts",
      "default": "./dist/capabilities.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./runtime-capabilities": {
      "types": "./dist/runtime-capabilities.d.ts",
      "default": "./dist/runtime-capabilities.js"
    },
    "./slot-capabilities": {
      "types": "./dist/slot-capabilities.d.ts",
      "default": "./dist/slot-capabilities.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "citty": "0.2.2",
    "execa": "catalog:",
    "package-manager-detector": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
