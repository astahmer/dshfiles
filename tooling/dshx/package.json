{
  "name": "dshx-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @dshfiles/dshx build && pnpm --filter create-dshx build",
    "lint": "pnpm --dir ../.. run lint",
    "format:check": "pnpm --dir ../.. run fmt:check",
    "deps:check": "knip",
    "typecheck": "pnpm --filter @dshfiles/dshx typecheck",
    "test": "pnpm --filter @dshfiles/dshx test",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm --filter create-dshx typecheck && pnpm --filter create-dshx test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "knip": "6.32.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.5.1"
}
