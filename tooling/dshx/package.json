{
  "name": "dshx-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter create-dshx build && pnpm --filter @dshfiles/dshx build",
    "lint": "pnpm --dir ../.. run lint",
    "format:check": "pnpm --dir ../.. run fmt:check",
    "deps:check": "knip",
    "typecheck": "pnpm --filter @dshfiles/dshx typecheck",
    "test": "pnpm run test:evidence && pnpm --filter @dshfiles/dshx test",
    "test:evidence": "node --experimental-strip-types --test e2e/support/evidence.test.ts e2e/support/evidence-reporter.integration.test.ts",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm --filter create-dshx typecheck && pnpm --filter create-dshx test && pnpm run test:boot",
    "test:boot": "node scripts/boot-check-web.mjs",
    "test:e2e": "pnpm run build && pnpm run test:e2e:gen && playwright test --config=playwright.e2e.config.ts",
    "test:e2e:boot": "pnpm run test:e2e",
    "test:e2e:gen": "bddgen test --config=playwright.e2e.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "catalog:",
    "knip": "6.32.2",
    "playwright-bdd": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.5.1"
}
