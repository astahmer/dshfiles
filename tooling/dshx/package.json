{
  "name": "dshx-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --dir ../.. exec turbo run build --filter=@dshfiles/dshx",
    "lint": "pnpm --dir ../.. run lint",
    "format:check": "pnpm --dir ../.. run fmt:check",
    "deps:check": "knip --directory ../.. --config \"$PWD/knip.jsonc\" --workspace tooling/dshx --workspace tooling/dshx/packages/dshx --workspace tooling/dshx/packages/create-dshx",
    "typecheck": "pnpm --dir ../.. exec turbo run typecheck --filter=@dshfiles/dshx",
    "test": "pnpm run test:evidence && pnpm run test:inventory && pnpm run test:feature-coverage && pnpm --dir ../.. exec turbo run test --filter=@dshfiles/dshx",
    "test:evidence": "node --experimental-strip-types --test e2e/support/evidence.test.ts e2e/support/evidence-reporter.integration.test.ts",
    "test:inventory": "node --test scripts/plugin-inventory.test.mjs",
    "test:feature-coverage": "node --test scripts/feature-coverage.test.mjs",
    "features:check": "node --experimental-strip-types scripts/feature-coverage.mjs --check",
    "features:report": "node --experimental-strip-types scripts/feature-coverage.mjs --report",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run features:check && pnpm --dir ../.. exec turbo run typecheck test --filter=create-dshx && node scripts/boot-check-web.mjs",
    "test:boot": "pnpm run build && node scripts/boot-check-web.mjs",
    "test:e2e": "pnpm run build && pnpm run test:e2e:gen && playwright test --config=playwright.e2e.config.ts",
    "test:e2e:boot": "pnpm run test:boot && pnpm run test:e2e",
    "test:e2e:gen": "bddgen test --config=playwright.e2e.config.ts"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@playwright/test": "1.56.1",
    "@types/node": "catalog:",
    "knip": "6.32.2",
    "playwright-bdd": "^8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.5.1"
}
