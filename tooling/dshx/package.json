{
  "name": "dshx-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --dir ../.. exec turbo run build --filter=@dshfiles/dshx",
    "lint": "pnpm --dir ../.. run lint",
    "format:check": "pnpm --dir ../.. run fmt:check",
    "deps:check": "knip --directory ../.. --config \"$PWD/../../knip.jsonc\" --no-config-hints --workspace tooling/dshx --workspace tooling/dshx/packages/dshx --workspace tooling/dshx/packages/create-dshx",
    "typecheck": "pnpm --dir ../.. exec turbo run typecheck --filter=@dshfiles/dshx",
    "test": "pnpm --dir ../.. exec turbo run test:evidence --filter=dshx-workspace --output-logs=new-only && node --experimental-strip-types --test e2e/support/http-fakes.test.ts && pnpm run test:inventory && pnpm run test:feature-coverage && pnpm run test:browser-tasks && pnpm run test:reap && pnpm run test:ssh-smoke-safety && pnpm --dir ../.. exec turbo run test --filter=@dshfiles/dshx",
    "test:evidence": "node --experimental-strip-types --test e2e/support/evidence.test.ts e2e/support/evidence-reporter.integration.test.ts && vitest run --config e2e/vitest.boot.config.ts",
    "test:inventory": "node --test scripts/plugin-inventory.test.mjs",
    "test:feature-coverage": "node --test scripts/feature-coverage.test.mjs",
    "test:browser-tasks": "node --test scripts/browser-tasks.test.mjs",
    "test:reap": "node --test scripts/reap-scratch-processes.test.mjs",
    "test:ssh-smoke-safety": "node --test scripts/smoke-multi-host-ssh.test.mjs scripts/smoke-multi-host-ssh-sshd.test.mjs",
    "browser-tasks:check": "node scripts/browser-tasks.mjs",
    "features:check": "node --experimental-strip-types scripts/feature-coverage.mjs --check",
    "features:report": "node --experimental-strip-types scripts/feature-coverage.mjs --report",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test && pnpm run features:check && pnpm run browser-tasks:check && pnpm --dir ../.. exec turbo run typecheck test --filter=create-dshx",
    "test:boot": "pnpm run build && node scripts/boot-check-web.mjs",
    "test:e2e": "pnpm run build && pnpm run test:e2e:gen && playwright test --config=playwright.e2e.config.ts",
    "test:e2e:boot": "pnpm run test:boot && pnpm run test:e2e",
    "test:e2e:gen": "bddgen test --config=playwright.e2e.config.ts"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@hono/node-server": "catalog:",
    "@playwright/test": "1.56.1",
    "@types/node": "catalog:",
    "hono": "catalog:",
    "knip": "6.32.2",
    "playwright-bdd": "8.5.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.5.1"
}
